  ],
  "ownershipRules": [
    "Input pointers are optional only when input_len is zero and are borrowed for that call only.",
    "Output pointers and capacities are caller-owned for the entire call; the runtime writes at most capacity and reports written_bytes.",
    "Every SOURCE_READ, QUERY_VIEWPORT, and CONTINUATION_NEXT output begins with a 96-byte RESULT_PAGE_HEADER; payload begins at struct_size and written_bytes includes header plus payload.",
    "A successful create/bulk append copies bytes into runtime-owned staging; commit or abort releases the staging transaction.",
    "Opaque handles are generation checked. Zero is never a live object; requestFieldRules exhaustively names operations where zero means none, uncommitted, or select-latest.",
    "StageRequest.chunk_len must equal its function input_len. SmallEditRequest.edit_count and replacement_bytes_len must equal the corresponding function arguments. A mismatch is INVALID_ARGUMENT.",
    "A small edit is one atomic batch of 1..64 sorted non-overlapping EditDescriptor records plus one packed replacement-byte slice. Descriptor replacement ranges must form an exact descriptor-order partition of that slice: offset zero first, no gaps, no overlap or reuse, and no unreferenced tail. Descriptor bytes, replacement bytes, and total deleted source bytes together must not exceed MAX_SMALL_EDIT_BYTES.",
    "One nonzero owner token serializes each session. Concurrent or reentrant calls return SESSION_BUSY or OWNER_MISMATCH.",
    "SESSION_TRANSFER_OWNER succeeds only while no operation, transaction, or continuation is active.",
    "Snapshot IDs are non-owning epochs. Only continuation handles retain result-generation state and require release.",
    "Abort and release operations detach their handle in at most one work unit; queued destruction is drained by PUMP or CLOSE_PUMP.",
    "No callback, filesystem path, Dart object, Flutter object, parser node, Rust layout, or recursive object graph crosses the ABI."
  ],
  "stateMachines": {
    "session": [
      "CREATE_BEGIN: NONE -> CREATING",
      "CREATE_COMMIT: CREATING -> OPEN",
      "CREATE_ABORT: CREATING -> CLOSED",
      "CLOSE_BEGIN: OPEN|FAULTED -> CLOSING",
      "CLOSE_BEGIN consumes progress token zero, rejects further source reads and writes, and returns the first nonzero close token.",
      "CLOSE_PUMP requires the latest nonzero close token and may reclaim source as well as derived state.",
      "CLOSE_FINISH requires the latest nonzero close token and atomically consumes the sole session handle only after zero live transaction, continuation, anchor, history-token, source, and derived state; no CLOSED session remains inspectable."
    ],
    "transaction": [
      "BEGIN -> STAGING; BULK_BEGIN permits expected_total_bytes zero for a pure deletion and routes large source ranges through resumable BULK_COMMIT",
      "SMALL_EDIT validates every descriptor, replacement slice, and aggregate deleted-source envelope against one expected revision before consuming exactly one work unit and committing all splices atomically; any error commits none and this operation never returns resumable progress.",
      "APPEND preserves STAGING and source revision",
      "COMMIT atomically changes source/revision and enters COMMITTED",
      "ABORT preserves source/revision and enters ABORTED"
    ],
    "progress": [
      "Every bounded pump returns ADVANCED, BUDGET_EXHAUSTED, RESULT_CAP_REACHED, COMPLETE, CANCELLED, SUPERSEDED, PENDING_SOURCE_GAP, BACKPRESSURED, or FAULT with its exact matching status.",
      "Repeating the same nonterminal token without an external requirement returns PROGRESS_STALLED and FAULT.",
      "Cancellation and supersession take effect only at pump boundaries."
    ],
    "certification": [
      "Semantic output is usable only for its exact revision, snapshot, and certified source range.",
      "NOT_CERTIFIED returns exact source with PENDING_NEUTRAL; stale semantics are never mapped forward.",
      "SOURCE_AND_SEMANTIC may return MIXED_CURRENT with an ordered current-revision certification partition and exact source.",
      "An edit invalidates or versions every prior continuation and snapshot."
    ]
  },
  "ambiguousOutcomeCoverage": [
    {"condition": "work budget consumed after progress", "status": "BUDGET_EXHAUSTED", "progressState": "BUDGET_EXHAUSTED"},
    {"condition": "bounded result page full with more data", "status": "RESULT_CAP_REACHED", "progressState": "RESULT_CAP_REACHED"},
    {"condition": "required staged source bytes not yet supplied", "status": "NOT_READY_SOURCE_GAP", "progressState": "PENDING_SOURCE_GAP"},
