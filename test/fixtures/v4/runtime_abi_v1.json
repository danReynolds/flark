  "returnCodeRule": "Every C entrypoint return value equals Outcome.status exactly. NEEDS_INPUT, NEEDS_OUTPUT_BUFFER, SESSION_CLOSED, and HISTORY_BUDGET_EXCEEDED retain numeric values for ABI stability but are reserved and never returned by ABI v4.0.",
  "budgetAdmissionRules": {
    "allBudgetedCalls": "max_work_units must be at least 1 and both result caps must not exceed the negotiated maxima; otherwise INVALID_ARGUMENT is returned before session state or borrowed input is consumed.",
    "pagePumpCalls": "QUERY_VIEWPORT and CONTINUATION_NEXT additionally require max_result_items and max_result_bytes to be nonzero, preventing a nonempty query from entering a zero-progress result-cap loop."
