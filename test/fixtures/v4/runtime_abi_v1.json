  "pageContract": {
    "runtimeAuthority": "flark_runtime::ResultPageReceipt",
    "abiEncoder": "flark_abi::ResultPageHeader::from_runtime",
    "sourceRead": "Requested range is at most MAX_SOURCE_CHUNK_BYTES. RESULT_PAGE_HEADER uses SOURCE_BYTES, NOT_APPLICABLE, snapshot zero, continuation zero, and payload bytes exactly equal covered-range bytes. The caller advances explicit ranges; SOURCE_READ never creates a continuation.",
    "initialViewport": "QUERY_VIEWPORT requires continuation zero. Snapshot zero selects the latest revision snapshot atomically; every returned viewport page names the resulting nonzero pinned snapshot.",
    "continuation": "CONTINUATION_NEXT and CONTINUATION_RELEASE must echo the exact nonzero revision, snapshot, and continuation from the prior page authority.",
    "pending": "A SEMANTIC query that is not certified returns NOT_CERTIFIED plus a SOURCE_BYTES PENDING_NEUTRAL page. SOURCE_AND_SEMANTIC returns ordered certification-range records followed by exact current source bytes; the page is PENDING_NEUTRAL, MIXED_CURRENT, or CURRENT_CERTIFIED."
  },
