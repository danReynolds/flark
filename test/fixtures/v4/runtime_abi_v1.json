    "rule": "For Heading rows, bits 0..7 contain parser-authored level 1..6 and bit 8 distinguishes Setext from ATX. For parser-authored List Item Paragraph and empty-item rows, marker code 1..5 occupies bits 0..2, nesting depth bits 3..10, marker offset bits 11..12, simple top-level continuation bit 13, and starts-list bit 14. ABI 4.4 gives BlockQuote Paragraph rows an explicit presentation bit, depth in bits 17..24, simple top-level continuation bit 25, and exact prefix ranges. Indented/Fenced Code rows carry the code presentation bit; fenced rows also carry fence family, closed state, offset, and minimum closing length. ThematicBreak rows carry their explicit presentation bit. ABI 4.7 gives bounded GFM Table Paragraph rows bit 26 and typed cell records. semantic_value is the literal ordered marker value, fenced minimum closing length, or zero otherwise. Other semantic bits are zero; ABI 4.5 assigns the former final reserved word to inline_fact_count."
  },
  "viewportInlineFacts": {
    "abiMinor": 6,
    "rowAuthoritativeBit": 8,
    "recordSizeBytes": 80,
    "maximumFactsPerRow": 64,
    "kinds": {
      "EMPHASIS": 1,
      "STRONG": 2,
      "CODE": 3,
      "STRIKETHROUGH": 4,
      "AUTOLINK_URI": 5,
      "AUTOLINK_EMAIL": 6,
      "BACKSLASH_ESCAPE": 7,
      "HARD_LINE_BREAK": 8,
      "REPLACEMENT": 9,
      "DIRECT_LINK": 10,
      "DIRECT_IMAGE": 11,
      "REFERENCE_LINK": 12,
      "REFERENCE_IMAGE": 13
    },
    "rule": "SEMANTIC_FACTS payloads contain item_count fixed row records followed by 80-byte semantic records grouped in row order. A row with bit 3 set owns exactly inline_fact_count following records; zero is an authoritative empty set. A row without bit 3 must have count zero and render exact source for inline presentation. Every source and visible-content range is absolute, current-revision, and supplied in both UTF-8 bytes and UTF-16 code units. Replacement records carry one required and one optional Unicode scalar; those words are zero for every other kind. ABI 4.7 table-cell kind 14 uses flags bits 0..1 for alignment, bit 2 for header cells, bit 3 for the first cell of a row, and bit 4 for an autocompleted empty cell. No row publishes a partial semantic set."
  },
  "viewportRowContinuity": {
    "abiMinor": 8,
    "plainTextInsertionBit": 16,
    "rule": "Viewport row flag bit 4 is parser-authored authority for retaining the row presentation during a nonempty conservative plain-text insertion wholly inside its contiguous editable UTF-16 range. The flag does not authorize deletion, replacement, syntax-shaped input, table or thematic-break presentation, or an insertion touching an inline fact. The host binds it to one exact transaction and revision."
  },
  "snapshotLifetime": {
    "ownership": "NON_OWNING_EPOCH",
    "rule": "A SnapshotId is an immutable epoch identifier, not a live handle and not independently released. It remains queryable only while its revision is current and the runtime still has that epoch; otherwise the result is STALE_SNAPSHOT. Only a nonzero continuation retains page-generation state and must be released. Releasing the last continuation permits immediate epoch reclamation."
  },
  "releaseDetachRule": "CREATE_ABORT, BULK_ABORT, CONTINUATION_RELEASE, ANCHOR_RELEASE, and HISTORY_RELEASE consume or detach their named handle in at most one work unit. Any nontrivial destruction moves to the session reclamation queue and is drained by PUMP or CLOSE_PUMP; these operations never return anonymous multi-call release progress.",
  "closeStatusRules": [
    {"operation": "CLOSE_BEGIN", "condition": "close entered and budget remains", "status": "OK", "progress": "COMPLETE", "token": "NEW_NONZERO"},
    {"operation": "CLOSE_BEGIN", "condition": "close entered and work budget ended", "status": "BUDGET_EXHAUSTED", "progress": "BUDGET_EXHAUSTED", "token": "NEW_NONZERO"},
    {"operation": "CLOSE_PUMP", "condition": "all reclaimable work drained", "status": "OK", "progress": "COMPLETE", "token": "CHANGED_NONZERO"},
    {"operation": "CLOSE_PUMP", "condition": "work budget ended after progress", "status": "BUDGET_EXHAUSTED", "progress": "BUDGET_EXHAUSTED", "token": "CHANGED_NONZERO"},
    {"operation": "CLOSE_FINISH", "condition": "all state drained", "status": "OK", "progress": "COMPLETE", "token": "ZERO_AND_SESSION_CONSUMED"},
    {"operation": "CLOSE_FINISH", "condition": "state remains", "status": "CLOSE_INCOMPLETE", "progress": "NONE", "token": "ECHO_UNCHANGED_NONZERO"},
    {"operation": "CLOSE_PUMP_OR_FINISH", "condition": "request token is not latest", "status": "STALE_PROGRESS_TOKEN", "progress": "NONE", "token": "ZERO"}
  ],
  "historyPolicy": {
    "accounting": "The configured history_budget_bytes counts retained inverse source bytes plus fixed token and index overhead defined by the implementation receipt.",
    "eviction": "Before retaining a new inverse, evict oldest committed tokens in commit order until it fits; released or replay-consumed tokens free their bytes first. A later use of an evicted token returns HISTORY_TOKEN_EVICTED.",
    "oversizedSingleInverse": "The source edit still commits atomically. primary_handle is zero and detail_code is HISTORY_OVER_BUDGET; undo availability is never allowed to reject or roll back accepted source input.",
    "disabled": "A zero history budget commits edits with primary_handle zero and HISTORY_DISABLED.",
    "retained": "A retained inverse returns a nonzero primary_handle and HISTORY_RETAINED. HISTORY_REPLAY consumes its input token and, under the same policy, may return one inverse token for redo."
  },
  "semanticCapabilityFreeze": "ABI 4.1 freezes SOURCE_AND_SEMANTIC as ordered 40-byte certification-range records followed by exact current source bytes for covered_range. Records partition the covered byte and UTF-16 ranges and carry only PENDING_NEUTRAL or CURRENT_CERTIFIED; the aggregate header may also be MIXED_CURRENT. No parser identity or prior row ordinal crosses this payload.",
  "outcomeEncodingRules": {
    "default": "Every scalar Outcome field not named by the operation row is zero. Rust implementations return the named typed OperationResult variant; flark-abi alone maps it into C fields.",
    "requiredBytes": "The host-neutral runtime reports required payload bytes only. For BUFFER_TOO_SMALL on a page operation, flark-abi always adds the fixed 96-byte page header, including when an empty page requires zero payload bytes. C Outcome.required_bytes is nonzero only for BUFFER_TOO_SMALL and is the exact minimum caller-output capacity for one complete record or page.",
    "writtenBytes": "The host-neutral runtime reports payload bytes only. flark-abi adds the page header. C Outcome.written_bytes is zero when no caller output was produced and otherwise is the exact bytes written including the fixed output header.",
    "detailCode": "Zero unless the operation row assigns a typed meaning. It never carries an undocumented internal error number."
  },
  "outcomeFieldRoles": [
