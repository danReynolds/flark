      "steps": [
        {"action": "replace-middle-reference-destination", "replacement": "alternate-destination-cycle-by-sample-index"},
        {"action": "assert-revision-and-source-hash-changed"},
        {"action": "query-visible-distant-use"},
        {"action": "assert-distant-projection-hash-changed"},
        {"action": "pump-to-visible-current-or-typed-terminal"}
      ]
    },
    {
      "id": "fence-close-reopen",
