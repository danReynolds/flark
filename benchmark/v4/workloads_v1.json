    },
    {
      "id": "paste-32kib",
      "stateContract": {
        "kind": "paste-reset",
        "stages": ["before", "pasted", "reset"],
        "paintedStage": "pasted",
        "finalStage": "reset",
        "positionAlgorithm": "first-paragraph-boundary-at-or-after-middle-or-eof",
        "generatorShapeId": "ordinary-prose",
        "pastedBytes": 32768,
        "sourceMutationCount": 2
      },
      "sampling": {
        "iterationUnit": "paste",
        "warmupIterationsPerRun": 2,
        "sampleIterationsPerRun": 30,
        "runCount": 3,
        "cadenceHz": 0,
        "totalSampleCount": 90
      },
      "steps": [
        {"action": "paste", "position": "middle-paragraph-scalar-boundary", "bytes": 32768, "generatorShapeId": "ordinary-prose"},
        {"action": "pump-to-visible-current-or-typed-terminal"},
        {"action": "export-and-verify-exact-post-paste-source"},
        {"action": "reset-to-exact-pre-sample-source-and-verify-hash"}
