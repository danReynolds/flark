    {
      "id": "undo-redo",
      "stateContract": {
        "kind": "undo-redo",
        "stages": ["before", "inserted", "undone", "redone"],
        "paintedStage": "redone",
        "finalStage": "redone",
        "positionAlgorithm": "floor-current-utf8-bytes-over-two",
        "insertedText": "undo-me",
        "sourceMutationCount": 3
