  "shapeRecipes": [
    {
      "id": "ordinary-prose",
      "categories": ["ordinary", "paragraphs"],
      "recipe": {
        "algorithm": "repeat_ascii_exact",
        "prefix": "",
        "cycle": "Ordinary prose opens with a clear sentence and a small **bold** run.\nIt continues with _emphasis_, `code`, and a direct [link](https://example.invalid/).\n\n"
      }
    },
    {
      "id": "delimiter-dense",
      "categories": ["markdown-dense", "inline-delimiters"],
      "recipe": {
        "algorithm": "repeat_ascii_exact",
        "prefix": "",
        "cycle": "***strong-em*** ~~strike~~ `code * literal` [label](https://example.invalid/a_(b)) ![alt](img.png)  \\\nnext\\*line\\_ []() <tag> &amp;\n\n"
      }
    },
    {
      "id": "giant-paragraph",
      "categories": ["oversized-block", "soft-lines"],
      "recipe": {
        "algorithm": "repeat_ascii_exact",
        "prefix": "",
        "cycle": "One paragraph continues across this physical line with words and **markup**.\n",
        "invariant": "No blank line occurs before targetBytes."
      }
    },
    {
      "id": "giant-physical-line",
      "categories": ["oversized-block", "oversized-physical-line"],
      "recipe": {
        "algorithm": "repeat_ascii_exact",
        "prefix": "",
        "cycle": "one-giant-line-with-words-and-**markup**-"
      }
    },
    {
      "id": "many-tiny-blocks",
      "categories": ["many-blocks", "virtualization"],
      "recipe": {
        "algorithm": "indexed_ascii_exact",
        "indexWidth": 8,
        "record": "p-{index}\n\n"
      }
    },
    {
      "id": "nested-containers",
      "categories": ["nested-lists", "block-quotes"],
      "recipe": {
        "algorithm": "repeat_ascii_exact",
        "prefix": "",
        "cycle": "> - outer item\n>   1. inner item with **bold**\n>      - third level\n>\n> lazy continuation\n\n"
      }
    },
    {
      "id": "gfm-tables-task-lists",
      "categories": ["gfm", "tables", "task-lists"],
      "recipe": {
        "algorithm": "repeat_ascii_exact",
        "prefix": "",
        "cycle": "| Name | Value |\n| --- | ---: |\n| alpha | 1 |\n| beta | 2 |\n\n- [x] complete\n- [ ] pending\n\n"
      }
    },
    {
      "id": "many-references",
      "categories": ["references", "non-local-dependency"],
      "recipe": {
        "algorithm": "indexed_ascii_exact",
        "indexWidth": 8,
        "record": "Use [ref-{index}] here.\n\n[ref-{index}]: https://example.invalid/{index}\n\n"
      }
    },
    {
      "id": "open-fence-to-eof",
      "categories": ["unclosed-fence", "eof-container"],
      "recipe": {
        "algorithm": "repeat_ascii_exact",
        "prefix": "~~~markdown\n",
        "cycle": "literal **marker** and [reference] text remains inside the open fence\n",
        "invariant": "No closing fence is emitted."
      }
    }
  ],
