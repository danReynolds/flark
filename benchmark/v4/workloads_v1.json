    {
      "id": "reference-retarget",
      "stateContract": {
        "kind": "replace-reference-destination",
        "stages": ["before", "retargeted"],
        "paintedStage": "retargeted",
        "finalStage": "retargeted",
        "positionAlgorithm": "first-reference-destination",
        "destinationIndexAlgorithm": "operation-ordinal-modulo-cycle-length",
        "sourceMutationCount": 1
      },
      "sampling": {
        "iterationUnit": "edit",
        "warmupIterationsPerRun": 10,
        "sampleIterationsPerRun": 100,
        "runCount": 3,
        "cadenceHz": 0,
        "totalSampleCount": 300
      },
      "destinationCycle": [
