      "sampling": {
        "iterationUnit": "edit",
        "warmupIterationsPerRun": 20,
        "sampleIterationsPerRun": 200,
        "runCount": 3,
        "cadenceHz": 60,
        "totalSampleCount": 600
      },
      "steps": [
        {"action": "backspace-one-grapheme", "position": "moving-caret"},
        {"action": "render-one-display-frame"}
      ]
    },
    {
      "id": "streaming-append",
      "stateContract": {
        "kind": "append-generated-bytes",
        "stages": ["before", "appended"],
        "paintedStage": "appended",
        "finalStage": "appended",
        "generatorShapeId": "ordinary-prose",
        "appendedBytes": 4096,
        "sourceMutationCount": 1
      },
      "sampling": {
        "iterationUnit": "append",
        "warmupIterationsPerRun": 4,
