      "steps": [
        {"action": "append", "text": "~~~\n"},
        {"action": "pump-to-visible-current-or-typed-terminal"},
        {"action": "delete-appended-bytes", "bytes": 4},
        {"action": "pump-to-visible-current-or-typed-terminal"}
      ]
