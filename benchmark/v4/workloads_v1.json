{
  "schemaVersion": 1,
  "matrixId": "flark-v4-performance-v1",
  "status": "m0-frozen",
  "units": {
    "documentSize": "UTF-8 bytes",
    "duration": "microseconds",
    "memory": "bytes",
    "displayCadence": "hertz"
  },
  "expandedWorkloadIdFormat": "flark-v4.<target>.<sizeTierId>.<shapeId>.<operationId>",
  "generatorContract": {
    "id": "flark-v4-deterministic-markdown-v1",
    "encoding": "UTF-8",
    "normalization": "none",
    "lineEndings": "recipe-owned",
    "rules": [
      "All recipe literals are ASCII so exact-byte truncation cannot split UTF-8.",
      "repeat_ascii_exact repeats prefix/cycle bytes and truncates the final cycle to targetBytes.",
      "indexed_ascii_exact substitutes a zero-padded decimal index before appending each record and truncates the final record to targetBytes.",
      "Every runner records actualBytes and SHA-256 and fails if actualBytes differs from the resolved target.",
      "Derived size tiers are resolved before a run from the named competitor receipt; their resolved byte count is recorded in the result."
    ]
  },
  "renderContract": {
    "id": "flark-v4-render-denominator-v1",
    "viewportLogicalWidth": 600,
    "viewportLogicalHeight": 600,
    "devicePixelRatio": 2,
    "textScaleFactor": 1,
    "fontAssetId": "FlarkBenchmarkMono-v1",
    "fontSizeLogicalPixels": 16,
    "lineHeight": 1.25,
    "fontWeight": 400,
    "letterSpacingLogicalPixels": 0,
    "minimumVisibleCharacters": 512
  },
  "renderEvidenceContract": {
    "projectionHashFormula": "sha256(canonical-json(sourceRevision,sourceSha256,visibleStartUtf8,visibleEndUtf8,visibleTextSha256))",
    "glyphRunHashFormula": "sha256(canonical-json(font-contract,visibleText))",
    "rasterHashFormula": "sha256(canonical-json(viewport-contract,glyphRunSha256,projectionSha256))"
  },
  "rawEvidenceContract": {
    "id": "flark-v4-raw-evidence-v1",
    "artifactKind": "flark-v4-raw-evidence-v1",
    "percentileMethod": "nearest-rank-ceil-p-times-n",
    "interactionLimitFormula": "min(16000, displayFramePeriodMicros)",
    "displayPeriodToleranceMicros": 1,
    "cadenceToleranceMicros": 1,
    "requiredSampleFields": [
      "runId",
      "sampleId",
      "sampleIndex",
      "processId",
      "frameId",
      "measurementStartVsyncOrdinal",
      "measurementEndVsyncOrdinal",
      "scheduledMicros",
      "acceptedMicros",
      "sourcePaintMicros",
      "caretPaintMicros",
      "selectionPaintMicros",
      "sourceRevisionBefore",
      "sourceRevisionAfter",
      "sourceSha256Before",
      "sourceSha256After",
      "distantProjectionSha256Before",
      "distantProjectionSha256After",
      "operationProof"
    ],
    "requiredFrameFields": [
      "runId",
      "frameId",
      "vsyncOrdinal",
      "processId",
      "sampleId",
      "editorAttributed",
      "vsyncStartMicros",
      "buildStartMicros",
      "buildFinishMicros",
      "rasterStartMicros",
      "rasterFinishMicros",
      "workUnitIds",
      "pumpIds"
    ],
    "claimReplay": [
      "Every declared artifact path exists and its byte length and SHA-256 match.",
      "The deterministic fixture is regenerated from the workload shape recipe and exact resolved bytes.",
      "Every measured and warmup iteration is replayed from the deterministic fixture through its exact operation stages; run-local final state chains into the next iteration.",
      "Every measurement interval declares a contiguous vsync-ordinal range; the retained frame stream contains every ordinal in every range and every sample links to exactly one proving frame.",
      "Every aggregate count, percentile, maximum, cadence, full-stream frame, memory, and lifecycle field is recomputed from raw records.",
      "Cold-open samples use distinct process IDs; other runs contain the exact frozen per-run denominator.",
      "Raw render proofs bind source revision and bytes to visible source range/content, deterministic glyph-run hash, projection hash, raster hash, and the proving frame.",
      "Memory and lifecycle rows name retained processes and use monotonic timestamps inside those process intervals, including baseline/peak/close/post-close and reopen ordering.",
      "Source, caret, selection, and their latest paint all meet the raw timestamp interaction limit."
    ]
  },
  "competitorResolutionContract": {
