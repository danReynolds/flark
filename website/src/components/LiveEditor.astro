---
import demo from '../generated/playground.json';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section class="live-demo" aria-label="Try Flark" id="try-flark">
  <div class="demo-heading">
    <p><span class="live-dot" aria-hidden="true"></span> Yours to explore <span class="demo-hint">— click in the document to start.</span></p>
    <span class="session-note">Just this session. Nothing to sign up for.</span>
  </div>
  <div class="demo-body">
    <iframe title="Live Flark Markdown editor" data-src={`${base}${demo.path}`} allow="clipboard-write" tabindex="0"></iframe>
    <div class="demo-loading" role="status">
      <span class="loading-mark" aria-hidden="true">f/</span>
      <strong>A little room to think.</strong>
      <p class="loading-message">Getting your document ready…</p>
      <button type="button" class="retry" hidden>Try again</button>
      <noscript>Enable JavaScript to explore the editor.</noscript>
    </div>
  </div>
</section>

<script>
  const demo = document.querySelector<HTMLElement>('.live-demo');
  const frame = demo?.querySelector<HTMLIFrameElement>('iframe');
  const loading = demo?.querySelector<HTMLElement>('.demo-loading');
  const message = demo?.querySelector<HTMLElement>('.loading-message');
  const retry = demo?.querySelector<HTMLButtonElement>('.retry');
  if (demo && frame && loading && message && retry) {
    let timer: ReturnType<typeof setTimeout>;
    let session = '';
    let started = false;
    const theme = () => document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
    const sendTheme = () => frame.contentWindow?.postMessage({
      type: 'flark-demo-theme', theme: theme(), session,
    }, location.origin);
    const fail = () => {
      clearTimeout(timer);
      message.textContent = 'The editor could not finish loading. Please try again.';
      retry.hidden = false;
    };
    const start = () => {
      clearTimeout(timer);
      session = crypto.randomUUID();
      const url = new URL(frame.dataset.src!, location.href);
      url.searchParams.set('theme', theme());
      url.searchParams.set('session', session);
      loading.hidden = false;
      retry.hidden = true;
      message.textContent = 'Getting your document ready…';
      frame.src = url.href;
      timer = setTimeout(fail, 45000);
      started = true;
    };
    window.addEventListener('message', (event) => {
      if (event.origin !== location.origin || event.source !== frame.contentWindow ||
          event.data?.session !== session) return;
      if (event.data.type === 'flark-demo-ready') {
        clearTimeout(timer);
        loading.hidden = true;
        sendTheme();
      } else if (event.data.type === 'flark-demo-error') {
        fail();
      }
    });
    new MutationObserver(sendTheme).observe(document.documentElement, {
      attributes: true, attributeFilter: ['data-theme'],
    });
    retry.addEventListener('click', start);
    // Keep the homepage lightweight until the actual editor is near the viewport.
    const observer = new IntersectionObserver((entries) => {
      if (!started && entries.some((entry) => entry.isIntersecting)) {
        start();
        observer.disconnect();
      }
    }, { rootMargin: '120px' });
    observer.observe(demo);
  }
</script>

<style>
  .live-demo { display: flex; flex-direction: column; flex: 1; min-height: 0; background: var(--home-surface); border-top: 1px solid var(--home-border); }
  .demo-heading { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: .5rem; padding: .75rem clamp(1.25rem, 4vw, 4.5rem); border-bottom: 1px solid var(--home-border); }
  .demo-heading p { display: flex; align-items: center; gap: .55rem; margin: 0; font-size: .75rem; color: var(--sl-color-white); }
  .live-dot { width: .4rem; height: .4rem; border-radius: 50%; background: var(--home-live); box-shadow: 0 0 0 3px var(--home-live-halo); }
  .demo-hint, .session-note { color: var(--sl-color-gray-3); }
  .session-note { font-size: .6875rem; }
  .demo-body { position: relative; flex: 1; min-height: 0; }
  iframe { display: block; width: 100%; height: 100%; border: 0; }
  .demo-loading { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2rem; text-align: center; background: var(--home-surface); gap: .8rem; color: var(--sl-color-gray-2); }
  .loading-mark { font: 2.5rem var(--sl-font-mono); color: var(--sl-color-accent-high); letter-spacing: -.15em; margin-bottom: .5rem; }
  .demo-loading strong { color: var(--sl-color-white); font-size: 1.1rem; font-weight: 500; }
  .demo-loading p, noscript { margin: 0; font-size: .85rem; max-width: 26ch; }
  .retry { font: inherit; font-size: .85rem; padding: .65rem 1rem; color: var(--sl-color-text-invert); border: 0; border-radius: .35rem; background: var(--sl-color-accent-high); cursor: pointer; }
  .retry:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 4px; }
  [hidden] { display: none !important; }
  @media (max-width: 40rem) { .session-note { display: none; } }
  @media (max-width: 25rem) { .demo-hint { display: none; } }
  @media (max-height: 38rem) { .demo-body { flex: none; height: 500px; } }
</style>
