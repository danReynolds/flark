+
+fn continuation_checkpoint(text: &str, offset: usize, options: &Options) -> ContinuationCheckpoint {
+    continuation_checkpoint_with(text, offset, options, |_| {})
+}
+
+fn raw_continuation_checkpoint(
+    text: &str,
+    offset: usize,
+    options: &Options,
+) -> ContinuationCheckpoint {
+    continuation_checkpoint_with(text, offset, options, |ast| match &ast.value {
+        NodeValue::CodeBlock(code) if code.fenced => {
+            let opener_end = ast
+                .content
+                .bytes()
+                .position(|byte| byte == b'\n')
+                .map_or(ast.content.len(), |index| index + 1);
+            ast.content.truncate(opener_end);
+            ast.line_offsets.truncate(1);
+        }
+        NodeValue::HtmlBlock(..) => {
+            ast.content.clear();
+            ast.line_offsets.clear();
+        }
+        _ => {}
+    })
+}
+
+fn continuation_checkpoint_with(
+    text: &str,
+    offset: usize,
+    options: &Options,
+    mut compact: impl FnMut(&mut Ast),
+) -> ContinuationCheckpoint {
+    let arena = Arena::new();
+    let mut parser = new_parser(&arena, options, text.len());
+    feed(&mut parser, text, 0, offset, |_, _| {});
+    let mut spine = Vec::new();
+    let mut node = parser.current;
+    loop {
+        let mut ast = node.data().clone();
+        compact(&mut ast);
+        spine.push(ast);
+        if node.same_node(parser.root) {
+            break;
+        }
+        node = node.parent().unwrap();
+    }
+    spine.reverse();
+    ContinuationCheckpoint {
+        offset,
+        line_number: parser.line_number,
+        last_line_length: parser.last_line_length,
+        open_spine: spine,
+    }
+}
+
+fn restore_continuation_checkpoint<'a, 'o, 'c>(
+    arena: &'a Arena<'a>,
+    checkpoint: &ContinuationCheckpoint,
+    options: &'o Options<'c>,
+    total_size: usize,
+) -> Parser<'a, 'o, 'c>
+where
+    'c: 'o,
+{
+    let mut parser = new_parser(arena, options, total_size);
+    parser.line_number = checkpoint.line_number;
+    parser.last_line_length = checkpoint.last_line_length;
+    let mut parent = parser.root;
+    for ast in checkpoint.open_spine.iter().skip(1) {
+        let node = arena.alloc(ast.clone().into());
+        parent.append(node);
+        parent = node;
+    }
+    parser.current = parent;
+    parser
+}
+
+fn continuation_states(text: &str, start: usize, options: &Options) -> HashMap<usize, u64> {
+    let arena = Arena::new();
+    let mut parser = new_parser(&arena, options, text.len());
+    let mut output = HashMap::new();
+    let mut offset = 0;
+    while offset < text.len() {
+        let line_end = text[offset..]
+            .find('\n')
+            .map_or(text.len(), |relative| offset + relative + 1);
+        parser.process_line(&text[offset..line_end]);
+        offset = line_end;
+        if offset >= start {
+            output.insert(offset, continuation_state(&parser));
+        }
+    }
+    output
+}
+
+fn continuation_state(parser: &Parser<'_, '_, '_>) -> u64 {
+    let mut spine = Vec::new();
+    let mut node = parser.current;
+    loop {
+        spine.push(node);
+        if node.same_node(parser.root) {
+            break;
+        }
+        node = node.parent().unwrap();
+    }
+    spine.reverse();
+    let mut hasher = DefaultHasher::new();
+    for node in spine {
+        let ast = node.data();
+        std::mem::discriminant(&ast.value).hash(&mut hasher);
+        format!("{:?}", ast.value).hash(&mut hasher);
+        ast.content.hash(&mut hasher);
+        ast.open.hash(&mut hasher);
+        ast.last_line_blank.hash(&mut hasher);
+    }
+    hasher.finish()
+}
+
+fn continuation_grammar_states(text: &str, start: usize, options: &Options) -> HashMap<usize, u64> {
+    let arena = Arena::new();
+    let mut parser = new_parser(&arena, options, text.len());
+    let mut output = HashMap::new();
+    let mut offset = 0;
+    while offset < text.len() {
+        let line_end = text[offset..]
+            .find('\n')
+            .map_or(text.len(), |relative| offset + relative + 1);
+        parser.process_line(&text[offset..line_end]);
+        offset = line_end;
+        if offset >= start {
+            output.insert(offset, continuation_grammar_state(&parser));
+        }
+    }
+    output
+}
+
+fn continuation_grammar_state(parser: &Parser<'_, '_, '_>) -> u64 {
+    let mut spine = Vec::new();
+    let mut node = parser.current;
+    loop {
+        spine.push(node);
+        if node.same_node(parser.root) {
+            break;
+        }
+        node = node.parent().unwrap();
+    }
+    spine.reverse();
+    let mut hasher = DefaultHasher::new();
+    for node in spine {
+        let ast = node.data();
+        std::mem::discriminant(&ast.value).hash(&mut hasher);
+        format!("{:?}", ast.value).hash(&mut hasher);
+        if !matches!(
+            ast.value,
+            NodeValue::CodeBlock(..) | NodeValue::HtmlBlock(..)
+        ) {
+            ast.content.hash(&mut hasher);
+        }
+        ast.open.hash(&mut hasher);
+        ast.last_line_blank.hash(&mut hasher);
+    }
+    hasher.finish()
+}
