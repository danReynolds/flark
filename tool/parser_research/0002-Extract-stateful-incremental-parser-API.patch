+#[test]
+fn stock_global_reference_budget_breaks_dependency_locality() {
+    let options = flark_options();
+    let mut body = String::new();
+    for index in 0..12_000 {
+        if index % 2 == 0 {
+            writeln!(body, "A {index}: [alpha][a]\n").unwrap();
+        } else {
+            writeln!(body, "B {index}: [beta][b]\n").unwrap();
+        }
+    }
+    let old = format!("{body}[a]: https://a.example/short\n[b]: https://b.example/value\n",);
+    let new = format!(
+        "{body}[a]: https://a.example/{}\n[b]: https://b.example/value\n",
+        "very-long-reference-value-".repeat(8),
+    );
+    let old = inline_document_snapshot(&old, &options);
+    let new = inline_document_snapshot(&new, &options);
+    assert_eq!(old.leaves.len(), new.leaves.len());
+
+    let unrelated = old.leaves.iter().zip(&new.leaves).find(|(before, after)| {
+        before.signature != after.signature
+            && !before.dependencies.iter().any(|label| label == "a")
+            && !after.dependencies.iter().any(|label| label == "a")
+    });
+    let Some((before, after)) = unrelated else {
+        panic!("expected the global clone budget to perturb a b-only leaf");
+    };
+    assert!(before.dependencies.iter().any(|label| label == "b"));
+    assert!(after.dependencies.iter().any(|label| label == "b"));
+    println!(
+        "comrak_reference_budget nonlocal_changed_range={:?} dependencies={:?}",
+        before.range, before.dependencies,
+    );
+
+    let old_unbounded = inline_document_snapshot_with_limit(
+        &format!("{body}[a]: https://a.example/short\n[b]: https://b.example/value\n",),
+        &options,
+        usize::MAX,
+    );
+    let new_unbounded = inline_document_snapshot_with_limit(
+        &format!(
+            "{body}[a]: https://a.example/{}\n[b]: https://b.example/value\n",
+            "very-long-reference-value-".repeat(8),
+        ),
+        &options,
+        usize::MAX,
+    );
+    assert!(
+        old_unbounded
+            .leaves
+            .iter()
+            .zip(&new_unbounded.leaves)
+            .filter(|(before, after)| before.signature != after.signature)
+            .all(|(before, after)| {
+                before.dependencies.iter().any(|label| label == "a")
+                    || after.dependencies.iter().any(|label| label == "a")
+            }),
+    );
+}
