+fn inline_document_snapshot(text: &str, options: &Options) -> InlineDocumentSnapshot {
+    inline_document_snapshot_with_limit(text, options, text.len().min(100000))
+}
+
+fn inline_document_snapshot_with_limit(
+    text: &str,
+    options: &Options,
+    reference_budget: usize,
+) -> InlineDocumentSnapshot {
+    let arena = Arena::new();
+    let mut parser = new_parser(&arena, options, text.len());
+    feed(&mut parser, text, 0, text.len(), |_, _| {});
+    finish_blocks_only(&mut parser);
+    parser.refmap.max_ref_size = reference_budget;
+    let line_starts = {
+        let mut starts = vec![0];
+        for (offset, byte) in text.bytes().enumerate() {
+            if byte == b'\n' {
+                starts.push(offset + 1);
+            }
+        }
+        starts
+    };
+    let inline_nodes: Vec<_> = parser
+        .root
+        .descendants()
+        .filter(|node| node.data().value.contains_inlines())
+        .collect();
+    let mut leaves = Vec::with_capacity(inline_nodes.len());
+    for node in inline_nodes {
+        let range = node_byte_range(node, text.len(), 0, &line_starts);
+        parser.refmap.begin_dependency_capture();
+        parser.parse_inlines(node);
+        parser.postprocess_text_nodes(node);
+        leaves.push(InlineLeafSnapshot {
+            range,
+            dependencies: parser.refmap.take_dependencies(),
+            signature: tree_signature(node),
+        });
+    }
+    InlineDocumentSnapshot {
+        leaves,
+        signature: tree_signature(parser.root),
+    }
+}
