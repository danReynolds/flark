@@ -0,0 +1,65 @@
+use std::fmt::Write as _;
+use std::time::Instant;
+
+use comrak::{IncrementalDocument, IncrementalEdit, Options};
+
+fn main() {
+    let mut source = String::with_capacity(1_100_000);
+    let mut edit_offsets = Vec::new();
+    let mut index = 0usize;
+    while source.len() < 1_000_000 {
+        writeln!(source, "## Section {index}").unwrap();
+        let edit_offset = source.len();
+        write!(
+            source,
+            "alpha-{index} has **strong** and [link][shared].\n\n"
+        )
+        .unwrap();
+        edit_offsets.push(edit_offset);
+        index += 1;
+    }
+    source.push_str("[shared]: https://example.com\n");
+
+    let options = Options::default();
+    let started = Instant::now();
+    let mut document = IncrementalDocument::new(source, &options);
+    let initial_micros = started.elapsed().as_micros();
+
+    let mut elapsed_micros = Vec::with_capacity(10_000);
+    let mut reparsed_bytes = Vec::with_capacity(10_000);
+    for (iteration, offset) in edit_offsets.into_iter().take(10_000).enumerate() {
+        let replacement = if iteration % 2 == 0 { "A" } else { "a" };
+        let request = IncrementalEdit::new(
+            document.revision(),
+            document.content_hash32(),
+            offset,
+            offset + 1,
+            replacement,
+        );
+        let started = Instant::now();
+        let delta = document.apply(request, &options).unwrap();
+        assert_eq!(delta.inserted_chunk_data().len(), delta.inserted_chunks());
+        assert_eq!(delta.removed_chunk_range().len(), delta.replaced_chunks());
+        elapsed_micros.push(started.elapsed().as_micros() as usize);
+        reparsed_bytes.push(delta.reparsed_bytes());
+    }
+
+    elapsed_micros.sort_unstable();
+    reparsed_bytes.sort_unstable();
+    println!(
+        "incremental_external document_bytes={} initial_us={} edits={} apply_us_p50={} apply_us_p95={} apply_us_p99={} apply_us_max={} reparsed_p95={} reparsed_max={}",
+        document.len_utf8(),
+        initial_micros,
+        elapsed_micros.len(),
+        percentile(&elapsed_micros, 50),
+        percentile(&elapsed_micros, 95),
+        percentile(&elapsed_micros, 99),
+        elapsed_micros.last().copied().unwrap_or_default(),
+        percentile(&reparsed_bytes, 95),
+        reparsed_bytes.last().copied().unwrap_or_default(),
+    );
+}
+
+fn percentile(values: &[usize], percentile: usize) -> usize {
+    values[(values.len() - 1) * percentile / 100]
+}
