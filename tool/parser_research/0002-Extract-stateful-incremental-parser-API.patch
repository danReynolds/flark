+    let mut count = 0;
+    for item in list.children() {
+        assert!(matches!(item.data().value, NodeValue::Item(..)));
+        let loose_if_nonlast = item.data().last_line_blank
+            || item.children().any(|child| child.ends_with_blank_line());
+        let loose_if_last = item
+            .children()
+            .filter(|child| child.next_sibling().is_some())
+            .any(|child| child.ends_with_blank_line());
+        aggregate = aggregate.combine(ListTightnessAggregate::item(ItemTightnessSummary {
+            loose_if_nonlast,
+            loose_if_last,
+        }));
+        count += 1;
+    }
+    assert_eq!(aggregate.tight(), expected, "fixture={text:?}");
