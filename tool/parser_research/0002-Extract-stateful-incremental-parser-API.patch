+    assert_eq!(
+        handle
+            .apply(
+                IncrementalEdit {
+                    base_revision: 1,
+                    before_hash32: 0,
+                    start_utf8: start,
+                    end_utf8: start,
+                    replacement: "divergent",
+                },
+                &options,
+            )
+            .unwrap_err(),
+        IncrementalError::Hash {
+            expected: handle.content_hash32(),
+            actual: 0,
+        },
+    );
+}
