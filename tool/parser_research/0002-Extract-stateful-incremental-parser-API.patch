+#[test]
+fn comrak_safe_checkpoint_convergence_is_usually_local() {
+    let original = large_document(200_000);
+    let options = flark_options();
+    let old_receipts = receipts(&original, &options);
+    let mut seed = 0x5eed_cafe_d15c_0a11u64;
+    let mut convergence = Vec::new();
+    let mut restart_distance = Vec::new();
+    let mut elapsed = Vec::new();
+
+    for iteration in 0..250 {
+        seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1);
+        let start = 32 + seed as usize % (original.len() - 64);
+        seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1);
+        let (old_end, replacement) = match iteration % 5 {
+            0 => (start, "x"),
+            1 => (start + 1, ""),
+            2 => (start + 1, "*"),
+            3 => (start, "\n"),
+            _ => (start + 1, if seed & 1 == 0 { "`" } else { "<" }),
+        };
+        let case = edit_range(&original, "randomized", start..old_end, replacement);
+        let restart = conservative_restart(&old_receipts, start);
+        let (distance, local_us) = work_until_convergence(
+            &original,
+            &case.markdown,
+            restart,
+            &old_receipts,
+            &case.old_range,
+            case.new_end,
+            &options,
+        );
+        let distance = distance.unwrap_or(case.markdown.len() - case.new_end);
+        elapsed.push(local_us as usize);
+        convergence.push(distance);
+        restart_distance.push(start - restart);
+    }
+
+    convergence.sort_unstable();
+    restart_distance.sort_unstable();
+    elapsed.sort_unstable();
+    println!(
+        "comrak_checkpoint_randomized cases={} convergence_p50={} convergence_p95={} convergence_p99={} convergence_max={} restart_p95={} local_us_p50={} local_us_p95={} local_us_max={}",
+        convergence.len(),
+        percentile(&convergence, 50),
+        percentile(&convergence, 95),
+        percentile(&convergence, 99),
+        convergence.last().copied().unwrap_or(0),
+        percentile(&restart_distance, 95),
+        percentile(&elapsed, 50),
+        percentile(&elapsed, 95),
+        elapsed.last().copied().unwrap_or(0),
+    );
+}
