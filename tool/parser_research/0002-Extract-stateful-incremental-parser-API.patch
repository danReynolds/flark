+            ("<!-- unbounded comment", "<!-- bounded comment -->"),
+            ("fence payload\n```\nAfter", "fence payload\n   \nAfter"),
+            ("fence payload\n   \nAfter", "fence payload\n```\nAfter"),
+            ("</script>\n\n| left", "not closed\n\n| left"),
