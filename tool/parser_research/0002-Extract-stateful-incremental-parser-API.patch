+//! Experimental stateful parser engine kept separate from upstream parser code.
+//!
+//! The test helpers remain colocated for this extraction spike. Production work
+//! should move them to a test-only child module before publishing the fork.
+
+#![allow(dead_code)]
+
+use std::collections::{BTreeMap, HashMap, HashSet};
+use std::fmt::Write as _;
+use std::hash::{DefaultHasher, Hash, Hasher};
+use std::ops::Range;
+use std::sync::Arc;
+use std::time::Instant;
+
+use crate::arena_tree::NodeEdge;
+
+use super::*;
+
+#[derive(Clone, Debug)]
+struct Receipt {
+    offset: usize,
+    state: u64,
+}
+
+struct Edit {
+    name: &'static str,
+    markdown: String,
+    old_range: Range<usize>,
+    new_end: usize,
+}
+
+/// One source-relative block node returned in an incremental chunk.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct IncrementalNode {
+    kind: String,
+    content: String,
+    range: Range<usize>,
+    children: Vec<IncrementalNode>,
+}
+
+impl IncrementalNode {
+    /// Returns the temporary Comrak node-kind representation used by the spike.
+    pub fn kind(&self) -> &str {
+        &self.kind
+    }
+
+    /// Returns source content retained by the Comrak block node.
+    pub fn content(&self) -> &str {
+        &self.content
+    }
+
+    /// Returns this node's source-relative UTF-8 byte range.
+    pub fn range_utf8(&self) -> Range<usize> {
+        self.range.clone()
+    }
+
+    /// Returns the node's source-relative children.
+    pub fn children(&self) -> &[IncrementalNode] {
+        &self.children
+    }
+}
+
+/// One stable-ID syntax chunk inserted by an incremental edit.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct IncrementalChunk {
+    id: u64,
+    order_key: u128,
+    source_len: usize,
+    nodes: Vec<IncrementalNode>,
+}
+
+impl IncrementalChunk {
+    /// Returns the stable chunk identifier.
+    pub fn id(&self) -> u64 {
+        self.id
+    }
+
+    /// Returns the stable document-order key.
+    pub fn order_key(&self) -> u128 {
+        self.order_key
+    }
+
+    /// Returns the chunk's UTF-8 source length.
+    pub fn source_len_utf8(&self) -> usize {
+        self.source_len
+    }
+
+    /// Returns source-relative block nodes in this chunk.
+    pub fn nodes(&self) -> &[IncrementalNode] {
+        &self.nodes
+    }
+}
+
+#[derive(Debug)]
+struct SyntaxChunk {
+    id: u64,
+    order_key: u128,
+    source_len: usize,
+    nodes: Vec<IncrementalNode>,
+    definitions: Vec<DefinitionOccurrence>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct DefinitionValue {
+    url: String,
+    title: String,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct DefinitionOccurrence {
+    label: String,
+    value: DefinitionValue,
+}
+
+#[derive(Clone)]
+struct IncrementalBlockDocument {
+    text: ByteRope,
+    chunks: SyntaxTree,
+    references: ReferenceIndex,
+    next_id: u64,
+}
+
+#[derive(Clone, Default)]
+struct ReferenceIndex {
+    by_label: HashMap<String, BTreeMap<(u128, usize), DefinitionValue>>,
+}
+
+#[derive(Debug, Default)]
+struct ReferenceIndexDelta {
+    presence_changed: Vec<String>,
+    value_changed: Vec<String>,
+}
+
+#[derive(Clone, Default)]
+struct ByteRope {
+    root: Option<Arc<ByteRopeNode>>,
+}
+
+#[derive(Debug)]
+enum ByteRopeNode {
+    Leaf {
+        source: Arc<str>,
+        start: usize,
+        len: usize,
+        newlines: usize,
+        hash32: u32,
+        hash_power32: u32,
+    },
+    Branch {
+        left: Arc<ByteRopeNode>,
+        right: Arc<ByteRopeNode>,
+        len: usize,
+        newlines: usize,
+        hash32: u32,
+        hash_power32: u32,
+        height: usize,
+    },
+}
+
+#[derive(Clone, Default)]
+struct SyntaxTree {
+    root: Option<Arc<SyntaxTreeNode>>,
+}
+
+#[derive(Debug)]
+enum SyntaxTreeNode {
+    Leaf(Arc<SyntaxChunk>),
+    Branch {
+        left: Arc<SyntaxTreeNode>,
+        right: Arc<SyntaxTreeNode>,
+        source_len: usize,
+        chunk_count: usize,
+        height: usize,
+    },
+}
+
+#[derive(Debug)]
+struct SpliceReceipt {
+    restart: usize,
+    convergence: usize,
+    reparsed_bytes: usize,
+    replaced_chunks: usize,
+    inserted_chunks: usize,
+    reused_chunks: usize,
+    parser_us: u128,
+    splice_us: u128,
+    delta_bytes: usize,
+    reference_delta: ReferenceIndexDelta,
+    removed_chunk_range: Range<usize>,
+    inserted_chunk_data: Vec<IncrementalChunk>,
+}
+
+/// A revisioned Markdown document backed by persistent source and block trees.
+pub struct IncrementalDocument {
+    revision: u64,
+    document: IncrementalBlockDocument,
+}
+
+/// One UTF-8 byte edit against a specific document revision and source hash.
+#[derive(Clone, Copy, Debug)]
+pub struct IncrementalEdit<'a> {
+    base_revision: u64,
+    before_hash32: u32,
+    start_utf8: usize,
+    end_utf8: usize,
+    replacement: &'a str,
+}
+
+/// A rejected incremental edit.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum IncrementalError {
+    /// The edit did not target the document's current revision.
+    Revision {
+        /// Current document revision.
+        expected: u64,
+        /// Revision supplied by the edit.
+        actual: u64,
+    },
+    /// The edit's source fingerprint did not match the current document.
+    Hash {
+        /// Current source fingerprint.
+        expected: u32,
+        /// Fingerprint supplied by the edit.
+        actual: u32,
+    },
+    /// The byte range was reversed or outside the document.
+    Range,
+    /// A byte boundary split a UTF-8 scalar value.
+    Utf8Boundary,
+}
+
+/// Work and revision metadata produced by one accepted edit.
+#[derive(Debug)]
+pub struct IncrementalDelta {
+    base_revision: u64,
+    revision: u64,
+    before_hash32: u32,
+    after_hash32: u32,
+    splice: SpliceReceipt,
+}
+
+#[derive(Debug)]
+struct InlineLeafSnapshot {
+    range: Range<usize>,
+    dependencies: Vec<String>,
+    signature: String,
+}
+
+struct InlineDocumentSnapshot {
+    leaves: Vec<InlineLeafSnapshot>,
+    signature: String,
+}
+
+#[derive(Clone)]
+struct ContinuationCheckpoint {
+    offset: usize,
+    line_number: usize,
+    last_line_length: usize,
+    open_spine: Vec<Ast>,
+}
+
+#[derive(Clone, Copy, Debug)]
+struct ItemTightnessSummary {
+    loose_if_nonlast: bool,
+    loose_if_last: bool,
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+struct ListTightnessAggregate {
+    len: usize,
+    loose_before_last: bool,
+    last: Option<ItemTightnessSummary>,
+}
+
+impl ListTightnessAggregate {
+    fn item(item: ItemTightnessSummary) -> Self {
+        Self {
+            len: 1,
+            loose_before_last: false,
+            last: Some(item),
+        }
+    }
+
+    fn combine(self, right: Self) -> Self {
+        if self.len == 0 {
+            return right;
+        }
+        if right.len == 0 {
+            return self;
+        }
+        Self {
+            len: self.len + right.len,
+            loose_before_last: self.loose_before_last
+                || self.last.unwrap().loose_if_nonlast
+                || right.loose_before_last,
+            last: right.last,
+        }
+    }
+
+    fn tight(self) -> bool {
+        !self.loose_before_last && !self.last.is_some_and(|last| last.loose_if_last)
+    }
+}
+
+impl ReferenceIndex {
+    fn from_tree(tree: &SyntaxTree) -> Self {
+        let mut index = Self::default();
+        tree.for_each_chunk(|chunk| index.insert_chunk(chunk));
+        index
+    }
+
+    fn winner(&self, label: &str) -> Option<&DefinitionValue> {
+        self.by_label
+            .get(label)
+            .and_then(|occurrences| occurrences.first_key_value())
+            .map(|(_, value)| value)
+    }
+
+    fn winner_map(&self) -> HashMap<String, DefinitionValue> {
+        self.by_label
+            .iter()
+            .filter_map(|(label, occurrences)| {
+                occurrences
+                    .first_key_value()
+                    .map(|(_, value)| (label.clone(), value.clone()))
+            })
+            .collect()
+    }
+
+    fn apply(
+        &mut self,
+        removed: &[Arc<SyntaxChunk>],
+        inserted: &[Arc<SyntaxChunk>],
+    ) -> ReferenceIndexDelta {
+        let labels: HashSet<_> = removed
+            .iter()
+            .chain(inserted)
+            .flat_map(|chunk| {
+                chunk
+                    .definitions
+                    .iter()
+                    .map(|definition| definition.label.clone())
+            })
+            .collect();
+        let before: HashMap<_, _> = labels
+            .iter()
+            .map(|label| (label.clone(), self.winner(label).cloned()))
+            .collect();
+        for chunk in removed {
+            self.remove_chunk(chunk);
+        }
+        for chunk in inserted {
+            self.insert_chunk(chunk);
+        }
+
+        let mut delta = ReferenceIndexDelta::default();
+        for label in labels {
+            let old = before.get(&label).cloned().flatten();
+            let new = self.winner(&label).cloned();
+            if old.is_some() != new.is_some() {
+                delta.presence_changed.push(label);
+            } else if old != new {
+                delta.value_changed.push(label);
+            }
+        }
+        delta.presence_changed.sort_unstable();
+        delta.value_changed.sort_unstable();
+        delta
+    }
+
+    fn insert_chunk(&mut self, chunk: &Arc<SyntaxChunk>) {
+        for (ordinal, definition) in chunk.definitions.iter().enumerate() {
+            self.by_label
+                .entry(definition.label.clone())
+                .or_default()
+                .insert((chunk.order_key, ordinal), definition.value.clone());
+        }
+    }
+
+    fn remove_chunk(&mut self, chunk: &Arc<SyntaxChunk>) {
+        let mut empty = Vec::new();
+        for (ordinal, definition) in chunk.definitions.iter().enumerate() {
+            let occurrences = self
+                .by_label
+                .get_mut(&definition.label)
+                .expect("removed definition must be indexed");
+            assert!(occurrences.remove(&(chunk.order_key, ordinal)).is_some());
+            if occurrences.is_empty() {
+                empty.push(definition.label.clone());
+            }
+        }
+        for label in empty {
+            self.by_label.remove(&label);
+        }
+    }
+}
+
+impl ByteRopeNode {
+    fn len(&self) -> usize {
+        match self {
+            Self::Leaf { len, .. } | Self::Branch { len, .. } => *len,
+        }
+    }
+
+    fn newlines(&self) -> usize {
+        match self {
+            Self::Leaf { newlines, .. } | Self::Branch { newlines, .. } => *newlines,
+        }
+    }
+
+    fn hash32(&self) -> u32 {
+        match self {
+            Self::Leaf { hash32, .. } | Self::Branch { hash32, .. } => *hash32,
+        }
+    }
+
+    fn hash_power32(&self) -> u32 {
+        match self {
+            Self::Leaf { hash_power32, .. } | Self::Branch { hash_power32, .. } => *hash_power32,
+        }
+    }
+
+    fn height(&self) -> usize {
+        match self {
+            Self::Leaf { .. } => 1,
+            Self::Branch { height, .. } => *height,
+        }
+    }
+}
+
+impl ByteRope {
+    const CHUNK_SIZE: usize = 4096;
+
+    fn from_str(text: &str) -> Self {
+        if text.is_empty() {
+            return Self::default();
+        }
+        let source: Arc<str> = Arc::from(text);
+        let mut leaves = Vec::new();
+        let mut start = 0;
+        while start < source.len() {
+            let mut end = (start + Self::CHUNK_SIZE).min(source.len());
+            while end > start && !source.is_char_boundary(end) {
+                end -= 1;
+            }
+            assert!(end > start);
+            leaves.push(byte_rope_leaf(source.clone(), start, end - start));
+            start = end;
+        }
+        fn build(nodes: &[Arc<ByteRopeNode>]) -> Option<Arc<ByteRopeNode>> {
+            match nodes.len() {
+                0 => None,
+                1 => Some(nodes[0].clone()),
+                len => {
+                    let middle = len / 2;
+                    Some(byte_rope_branch(
+                        build(&nodes[..middle]).unwrap(),
+                        build(&nodes[middle..]).unwrap(),
+                    ))
+                }
+            }
+        }
+        Self {
+            root: build(&leaves),
+        }
+    }
+
+    fn len(&self) -> usize {
+        self.root.as_deref().map_or(0, ByteRopeNode::len)
+    }
+
+    fn newlines(&self) -> usize {
+        self.root.as_deref().map_or(0, ByteRopeNode::newlines)
+    }
+
+    fn hash32(&self) -> u32 {
+        self.root.as_deref().map_or(0, ByteRopeNode::hash32)
+    }
+
+    fn is_char_boundary(&self, offset: usize) -> bool {
+        if offset == 0 || offset == self.len() {
+            return true;
+        }
+        if offset > self.len() {
+            return false;
+        }
+        fn visit(node: &Arc<ByteRopeNode>, offset: usize) -> bool {
+            match node.as_ref() {
+                ByteRopeNode::Leaf {
+                    source, start, len, ..
+                } => offset <= *len && source.is_char_boundary(start + offset),
+                ByteRopeNode::Branch { left, right, .. } => {
+                    if offset < left.len() {
+                        visit(left, offset)
+                    } else if offset == left.len() {
+                        true
+                    } else {
+                        visit(right, offset - left.len())
+                    }
+                }
+            }
+        }
+        visit(self.root.as_ref().unwrap(), offset)
+    }
+
+    fn replace(&self, start: usize, end: usize, replacement: &str) -> Self {
+        assert!(start <= end && end <= self.len());
+        assert!(self.is_char_boundary(start));
+        assert!(self.is_char_boundary(end));
+        let (prefix, rest) = split_byte_rope(self.root.clone(), start);
+        let (_, suffix) = split_byte_rope(rest, end - start);
+        Self {
+            root: concat_byte_rope(
+                concat_byte_rope(prefix, Self::from_str(replacement).root),
+                suffix,
+            ),
+        }
+    }
+
+    fn slice(&self, start: usize, end: usize) -> String {
+        assert!(start <= end && end <= self.len());
+        fn write(node: &Arc<ByteRopeNode>, start: usize, end: usize, output: &mut String) {
+            if start >= end {
+                return;
+            }
+            match node.as_ref() {
+                ByteRopeNode::Leaf {
+                    source,
+                    start: source_start,
+                    ..
+                } => output.push_str(&source[source_start + start..source_start + end]),
+                ByteRopeNode::Branch { left, right, .. } => {
+                    if start < left.len() {
+                        write(left, start, end.min(left.len()), output);
+                    }
+                    if end > left.len() {
+                        write(
+                            right,
+                            start.saturating_sub(left.len()),
+                            end - left.len(),
+                            output,
+                        );
+                    }
+                }
+            }
+        }
+        let mut output = String::with_capacity(end - start);
+        if let Some(root) = &self.root {
+            write(root, start, end, &mut output);
+        }
+        output
+    }
+
+    fn line_from(&self, offset: usize) -> (usize, String) {
+        assert!(offset < self.len());
+        let end = next_newline(&self.root, 0, offset).map_or(self.len(), |newline| newline + 1);
+        (end, self.slice(offset, end))
+    }
+
+    fn newlines_before(&self, offset: usize) -> usize {
+        assert!(offset <= self.len());
+        fn count(node: &Arc<ByteRopeNode>, offset: usize) -> usize {
+            if offset == 0 {
+                return 0;
+            }
+            if offset == node.len() {
+                return node.newlines();
+            }
+            match node.as_ref() {
+                ByteRopeNode::Leaf { source, start, .. } => source.as_bytes()
+                    [*start..*start + offset]
+                    .iter()
+                    .filter(|byte| **byte == b'\n')
+                    .count(),
+                ByteRopeNode::Branch { left, right, .. } => {
+                    if offset <= left.len() {
+                        count(left, offset)
+                    } else {
+                        left.newlines() + count(right, offset - left.len())
+                    }
+                }
+            }
+        }
+        self.root.as_ref().map_or(0, |root| count(root, offset))
+    }
+
+    fn previous_line_length(&self, offset: usize) -> usize {
+        if offset == 0 {
+            return 0;
+        }
+        let end = if self.slice(offset - 1, offset) == "\n" {
+            offset - 1
+        } else {
+            offset
+        };
+        let start = previous_newline(&self.root, 0, end).map_or(0, |newline| newline + 1);
+        let mut len = end - start;
+        if len > 0 && self.slice(end - 1, end) == "\r" {
+            len -= 1;
+        }
+        len
+    }
+
+    fn materialize(&self) -> String {
+        self.slice(0, self.len())
+    }
+}
+
+fn byte_rope_leaf(source: Arc<str>, start: usize, len: usize) -> Arc<ByteRopeNode> {
+    let bytes = &source.as_bytes()[start..start + len];
+    let mut hash = 0u32;
+    let mut power = 1u32;
+    for byte in bytes {
+        hash = hash
+            .wrapping_mul(0x0010_0193)
+            .wrapping_add(*byte as u32 + 1);
+        power = power.wrapping_mul(0x0010_0193);
+    }
+    let newlines = bytes.iter().filter(|byte| **byte == b'\n').count();
+    Arc::new(ByteRopeNode::Leaf {
+        source,
+        start,
+        len,
+        newlines,
+        hash32: hash,
+        hash_power32: power,
+    })
+}
+
+fn byte_rope_branch(left: Arc<ByteRopeNode>, right: Arc<ByteRopeNode>) -> Arc<ByteRopeNode> {
+    Arc::new(ByteRopeNode::Branch {
+        len: left.len() + right.len(),
+        newlines: left.newlines() + right.newlines(),
+        hash32: left
+            .hash32()
+            .wrapping_mul(right.hash_power32())
+            .wrapping_add(right.hash32()),
+        hash_power32: left.hash_power32().wrapping_mul(right.hash_power32()),
+        height: left.height().max(right.height()) + 1,
+        left,
+        right,
+    })
+}
+
+fn split_byte_rope(
+    node: Option<Arc<ByteRopeNode>>,
+    offset: usize,
+) -> (Option<Arc<ByteRopeNode>>, Option<Arc<ByteRopeNode>>) {
+    let Some(node) = node else {
+        assert_eq!(offset, 0);
+        return (None, None);
+    };
+    assert!(offset <= node.len());
+    if offset == 0 {
+        return (None, Some(node));
+    }
+    if offset == node.len() {
+        return (Some(node), None);
+    }
+    match node.as_ref() {
+        ByteRopeNode::Leaf {
+            source, start, len, ..
+        } => (
+            Some(byte_rope_leaf(source.clone(), *start, offset)),
+            Some(byte_rope_leaf(source.clone(), start + offset, len - offset)),
+        ),
+        ByteRopeNode::Branch { left, right, .. } => {
+            if offset < left.len() {
+                let (prefix, rest) = split_byte_rope(Some(left.clone()), offset);
+                (prefix, concat_byte_rope(rest, Some(right.clone())))
+            } else if offset == left.len() {
+                (Some(left.clone()), Some(right.clone()))
+            } else {
+                let (rest, suffix) = split_byte_rope(Some(right.clone()), offset - left.len());
+                (concat_byte_rope(Some(left.clone()), rest), suffix)
+            }
+        }
+    }
+}
+
+fn concat_byte_rope(
+    left: Option<Arc<ByteRopeNode>>,
+    right: Option<Arc<ByteRopeNode>>,
+) -> Option<Arc<ByteRopeNode>> {
+    let (left, right) = match (left, right) {
+        (None, right) => return right,
+        (left, None) => return left,
+        (Some(left), Some(right)) => (left, right),
+    };
+    if left.height() > right.height() + 1 {
+        let ByteRopeNode::Branch {
+            left: outer_left,
+            right: inner_left,
+            ..
+        } = left.as_ref()
+        else {
+            unreachable!()
+        };
+        return Some(balance_byte_rope(byte_rope_branch(
+            outer_left.clone(),
+            concat_byte_rope(Some(inner_left.clone()), Some(right)).unwrap(),
+        )));
+    }
+    if right.height() > left.height() + 1 {
+        let ByteRopeNode::Branch {
+            left: inner_right,
+            right: outer_right,
+            ..
+        } = right.as_ref()
+        else {
+            unreachable!()
+        };
+        return Some(balance_byte_rope(byte_rope_branch(
+            concat_byte_rope(Some(left), Some(inner_right.clone())).unwrap(),
+            outer_right.clone(),
+        )));
+    }
+    Some(byte_rope_branch(left, right))
+}
+
+fn balance_byte_rope(node: Arc<ByteRopeNode>) -> Arc<ByteRopeNode> {
+    let ByteRopeNode::Branch { left, right, .. } = node.as_ref() else {
+        return node;
+    };
+    let balance = left.height() as isize - right.height() as isize;
+    if balance > 1 {
+        let ByteRopeNode::Branch {
+            left: left_left,
+            right: left_right,
+            ..
+        } = left.as_ref()
+        else {
+            unreachable!()
+        };
+        if left_left.height() < left_right.height() {
+            let ByteRopeNode::Branch {
+                left: pivot_left,
+                right: pivot_right,
+                ..
+            } = left_right.as_ref()
+            else {
+                unreachable!()
+            };
+            return byte_rope_branch(
+                byte_rope_branch(left_left.clone(), pivot_left.clone()),
+                byte_rope_branch(pivot_right.clone(), right.clone()),
+            );
+        }
+        return byte_rope_branch(
+            left_left.clone(),
+            byte_rope_branch(left_right.clone(), right.clone()),
+        );
+    }
+    if balance < -1 {
+        let ByteRopeNode::Branch {
+            left: right_left,
+            right: right_right,
+            ..
+        } = right.as_ref()
+        else {
+            unreachable!()
+        };
+        if right_right.height() < right_left.height() {
+            let ByteRopeNode::Branch {
+                left: pivot_left,
+                right: pivot_right,
+                ..
+            } = right_left.as_ref()
+            else {
+                unreachable!()
+            };
+            return byte_rope_branch(
+                byte_rope_branch(left.clone(), pivot_left.clone()),
+                byte_rope_branch(pivot_right.clone(), right_right.clone()),
+            );
+        }
+        return byte_rope_branch(
+            byte_rope_branch(left.clone(), right_left.clone()),
+            right_right.clone(),
+        );
+    }
+    node
+}
+
+fn next_newline(node: &Option<Arc<ByteRopeNode>>, base: usize, offset: usize) -> Option<usize> {
+    let node = node.as_ref()?;
+    if node.newlines() == 0 || base + node.len() <= offset {
+        return None;
+    }
+    match node.as_ref() {
+        ByteRopeNode::Leaf {
+            source, start, len, ..
+        } => {
+            let local_start = offset.saturating_sub(base).min(*len);
+            source.as_bytes()[start + local_start..start + len]
+                .iter()
+                .position(|byte| *byte == b'\n')
+                .map(|relative| base + local_start + relative)
+        }
+        ByteRopeNode::Branch { left, right, .. } => next_newline(&Some(left.clone()), base, offset)
+            .or_else(|| next_newline(&Some(right.clone()), base + left.len(), offset)),
+    }
+}
+
+fn previous_newline(node: &Option<Arc<ByteRopeNode>>, base: usize, offset: usize) -> Option<usize> {
+    let node = node.as_ref()?;
+    if node.newlines() == 0 || base >= offset {
+        return None;
+    }
+    match node.as_ref() {
+        ByteRopeNode::Leaf {
+            source, start, len, ..
+        } => {
+            let local_end = offset.saturating_sub(base).min(*len);
+            source.as_bytes()[*start..start + local_end]
+                .iter()
+                .rposition(|byte| *byte == b'\n')
+                .map(|relative| base + relative)
+        }
+        ByteRopeNode::Branch { left, right, .. } => {
+            previous_newline(&Some(right.clone()), base + left.len(), offset)
+                .or_else(|| previous_newline(&Some(left.clone()), base, offset))
+        }
+    }
+}
