+    );
+
+    let first_url = source.find("https://first.example/value").unwrap();
+    let delta = handle
+        .apply(
+            IncrementalEdit {
+                base_revision: 0,
+                before_hash32: handle.content_hash32(),
+                start_utf8: first_url,
+                end_utf8: first_url + "https://first.example/value".len(),
+                replacement: "https://changed.example/value",
+            },
+            &options,
+        )
+        .unwrap();
+    assert!(delta.splice.reference_delta.presence_changed.is_empty());
+    assert_eq!(delta.splice.reference_delta.value_changed, ["x"]);
+    assert_eq!(
