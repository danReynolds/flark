+            assert_inline_snapshot_matches_full(&document.text.materialize(), &options);
+        }
+
+        let current = document.text.materialize();
+        let first = "[dup]: https://first.example/a\n";
+        let first_start = current.rfind(first).unwrap();
+        document.apply_edit(first_start..first_start + first.len(), "", &options);
+        edits += 1;
