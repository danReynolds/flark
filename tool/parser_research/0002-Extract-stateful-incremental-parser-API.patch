+        document.apply_edit(second_start..second_start, first, &options);
+        edits += 1;
+        assert_inline_snapshot_matches_full(&document.text.materialize(), &options);
+    }
+    assert_eq!(edits, 180);
+    println!("comrak_adversarial_transitions edits={edits} exact=true");
+}
+
+fn apply_named_replacement(
+    document: &mut IncrementalBlockDocument,
+    before: &str,
+    after: &str,
+    options: &Options,
+) {
+    let current = document.text.materialize();
+    let start = current
+        .find(before)
+        .unwrap_or_else(|| panic!("missing {before:?}"));
+    document.apply_edit(start..start + before.len(), after, options);
+}
