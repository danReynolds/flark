+        "https://changed.example/value",
+    );
+
+    let current = handle.document.text.materialize();
+    let first_definition_end = current.find("\n\n").unwrap() + 1;
+    let delta = handle
+        .apply(
+            IncrementalEdit {
+                base_revision: 1,
+                before_hash32: handle.content_hash32(),
+                start_utf8: 0,
+                end_utf8: first_definition_end,
+                replacement: "",
+            },
+            &options,
+        )
+        .unwrap();
+    assert!(delta.splice.reference_delta.presence_changed.is_empty());
+    assert_eq!(delta.splice.reference_delta.value_changed, ["x"]);
+    assert_eq!(
+        handle.document.references.winner("x").unwrap().url,
+        "https://second.example/value",
+    );
+
+    let current = handle.document.text.materialize();
+    let second_start = current.find("[x]: https://second.example/value").unwrap();
+    let delta = handle
+        .apply(
+            IncrementalEdit {
+                base_revision: 2,
+                before_hash32: handle.content_hash32(),
+                start_utf8: second_start,
+                end_utf8: current.len(),
+                replacement: "",
+            },
+            &options,
+        )
+        .unwrap();
+    assert_eq!(delta.splice.reference_delta.presence_changed, ["x"]);
+    assert!(delta.splice.reference_delta.value_changed.is_empty());
+    assert!(handle.document.references.winner("x").is_none());
