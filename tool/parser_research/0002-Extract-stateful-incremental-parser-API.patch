+#[test]
+fn in_container_list_checkpoint_restores_exact_continuation_state() {
+    let options = flark_options();
+    let original = giant_list(1_000_000);
+    let item_count = original.matches("- item ").count();
+    let target = format!("- item {} with", item_count / 2);
+    let edit_start = original.find(&target).unwrap() + target.len() - "with".len();
+    let checkpoint_offset = original[..edit_start].rfind('\n').unwrap() + 1;
+    let checkpoint = continuation_checkpoint(&original, checkpoint_offset, &options);
+    assert_eq!(checkpoint.offset, checkpoint_offset);
+    assert!(checkpoint.open_spine.len() >= 3);
+
+    let edited = edit_range(
+        &original,
+        "giant_list_local",
+        edit_start..edit_start + "with".len(),
+        "now with",
+    );
+    let full_states = continuation_states(&edited.markdown, checkpoint_offset, &options);
+    let arena = Arena::new();
+    let mut resumed =
+        restore_continuation_checkpoint(&arena, &checkpoint, &options, edited.markdown.len());
+    let mut offset = checkpoint_offset;
+    let mut first_convergence = None;
+    let old_states = continuation_states(&original, checkpoint_offset, &options);
+    let byte_delta = edited.markdown.len() as isize - original.len() as isize;
+    while offset < edited.markdown.len() {
+        let line_end = edited.markdown[offset..]
+            .find('\n')
+            .map_or(edited.markdown.len(), |relative| offset + relative + 1);
+        resumed.process_line(&edited.markdown[offset..line_end]);
+        offset = line_end;
+        assert_eq!(
+            continuation_state(&resumed),
+            full_states[&offset],
+            "restored parser diverged at byte {offset}",
+        );
+        if offset >= edited.new_end {
+            let mapped = offset as isize - byte_delta;
+            if mapped >= edited.old_range.end as isize
+                && old_states.get(&(mapped as usize)) == Some(&continuation_state(&resumed))
+            {
+                first_convergence = Some((offset, mapped as usize));
+                break;
+            }
+        }
+    }
+    let (new_convergence, old_convergence) =
+        first_convergence.expect("giant list state should converge locally");
+    let convergence = new_convergence - edited.new_end;
+    assert!(convergence < 128, "convergence={convergence}");
+
+    // A state match is useful only if the old suffix can actually be retained.
+    // The checkpoint carries the previously-open item, so replace from that
+    // item through the item immediately before the converged current item.
+    let original_line_starts = line_starts_for(&original);
+    let edited_line_starts = line_starts_for(&edited.markdown);
+    let replacement_start = checkpoint
+        .open_spine
+        .iter()
+        .rev()
+        .find(|ast| matches!(ast.value, NodeValue::Item(..)))
+        .map(|ast| {
+            sourcepos_byte_range(ast.sourcepos, original.len(), 0, &original_line_starts).start
+        })
+        .expect("checkpoint must contain an open list item");
+    let current_item = ancestor_matching(resumed.current, |value| {
+        matches!(value, NodeValue::Item(..))
+    })
+    .expect("resumed parser must be inside the converged list item");
+    let current_list = current_item.parent().expect("item must have a list parent");
+    assert!(matches!(current_list.data().value, NodeValue::List(..)));
+    let suffix_start_new =
+        node_byte_range(current_item, edited.markdown.len(), 0, &edited_line_starts).start;
+    let suffix_start_old = suffix_start_new
+        .checked_add_signed(-byte_delta)
+        .expect("converged suffix must map into the old document");
+    assert!(suffix_start_old < old_convergence);
+
+    let replacement_items: Vec<_> = current_list
+        .children()
+        .take_while(|item| !item.same_node(current_item))
+        .map(|item| owned_block_node(item, edited.markdown.len(), 0, &edited_line_starts, 0))
+        .collect();
+    assert!(!replacement_items.is_empty());
+
+    let old_items = full_list_items(&original, &options);
+    let mut spliced_items: Vec<_> = old_items
+        .iter()
+        .take_while(|item| item.range.start < replacement_start)
+        .cloned()
+        .collect();
+    spliced_items.extend(replacement_items.iter().cloned());
+    let reused_suffix: Vec<_> = old_items
+        .iter()
+        .skip_while(|item| item.range.start < suffix_start_old)
+        .map(|item| shifted_node(item, byte_delta as usize))
+        .collect();
+    assert!(!reused_suffix.is_empty());
+    spliced_items.extend(reused_suffix.iter().cloned());
+    assert_eq!(
+        spliced_items,
+        full_list_items(&edited.markdown, &options),
+        "checkpoint replacement plus reused suffix must equal a clean full list parse",
+    );
+    println!(
+        "comrak_in_container_list checkpoint={} open_depth={} convergence_bytes={} replacement_items={} reused_suffix_items={}",
+        checkpoint_offset,
+        checkpoint.open_spine.len(),
+        convergence,
+        replacement_items.len(),
+        reused_suffix.len(),
+    );
+}
+
+fn ancestor_matching<'a>(
+    mut node: Node<'a>,
+    predicate: impl Fn(&NodeValue) -> bool,
+) -> Option<Node<'a>> {
+    loop {
+        if predicate(&node.data().value) {
+            return Some(node);
+        }
+        node = node.parent()?;
+    }
+}
+
+fn line_starts_for(text: &str) -> Vec<usize> {
+    let mut starts = vec![0];
+    starts.extend(
+        text.bytes()
+            .enumerate()
+            .filter_map(|(index, byte)| (byte == b'\n').then_some(index + 1)),
+    );
+    starts
+}
+
+fn full_list_items(text: &str, options: &Options) -> Vec<IncrementalNode> {
+    let line_starts = line_starts_for(text);
+    let arena = Arena::new();
+    let mut parser = new_parser(&arena, options, text.len());
+    feed(&mut parser, text, 0, text.len(), |_, _| {});
+    finish_blocks_only(&mut parser);
+    let list = parser
+        .root
+        .children()
+        .find(|node| matches!(node.data().value, NodeValue::List(..)))
+        .expect("fixture must contain a top-level list");
+    list.children()
+        .map(|item| owned_block_node(item, text.len(), 0, &line_starts, 0))
+        .collect()
+}
