+fn run_sequential_checkpoint_edits(target_bytes: usize, iterations: usize, label: &str) {
+    let options = flark_options();
+    let mut document = IncrementalBlockDocument::new(large_document(target_bytes), &options);
+    let mut seed = 0xd1ff_e2e5_5eed_u64;
+    let mut reparsed = Vec::new();
+    let mut parser_us = Vec::new();
+    let mut replaced = Vec::new();
+    let mut splice_us = Vec::new();
+    let mut delta_bytes = Vec::new();
+
+    for iteration in 0..iterations {
+        seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1);
+        let start = 32 + seed as usize % (document.text.len() - 64);
+        seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1);
+        let (old_end, replacement) = match iteration % 6 {
+            0 => (start, "x"),
+            1 => (start + 1, ""),
+            2 => (start + 1, "*"),
+            3 => (start, "\n"),
+            4 => (start + 1, if seed & 1 == 0 { "`" } else { "<" }),
+            _ => (start, " "),
+        };
+        let receipt = document.apply_edit(start..old_end, replacement, &options);
+        reparsed.push(receipt.reparsed_bytes);
+        parser_us.push(receipt.parser_us as usize);
+        replaced.push(receipt.replaced_chunks);
+        splice_us.push(receipt.splice_us as usize);
+        delta_bytes.push(receipt.delta_bytes);
+    }
+
+    reparsed.sort_unstable();
+    parser_us.sort_unstable();
+    replaced.sort_unstable();
+    splice_us.sort_unstable();
+    delta_bytes.sort_unstable();
+    println!(
+        "comrak_suffix_splice_sequential label={} document_bytes={} cases={} reparsed_p50={} reparsed_p95={} reparsed_p99={} reparsed_max={} parser_us_p50={} parser_us_p95={} parser_us_max={} splice_us_p50={} splice_us_p95={} splice_us_max={} delta_bytes_p50={} delta_bytes_p95={} delta_bytes_max={} replaced_chunks_p95={}",
+        label,
+        document.text.len(),
+        reparsed.len(),
+        percentile(&reparsed, 50),
+        percentile(&reparsed, 95),
+        percentile(&reparsed, 99),
+        reparsed.last().copied().unwrap_or(0),
+        percentile(&parser_us, 50),
+        percentile(&parser_us, 95),
+        parser_us.last().copied().unwrap_or(0),
+        percentile(&splice_us, 50),
+        percentile(&splice_us, 95),
+        splice_us.last().copied().unwrap_or(0),
+        percentile(&delta_bytes, 50),
+        percentile(&delta_bytes, 95),
+        delta_bytes.last().copied().unwrap_or(0),
+        percentile(&replaced, 95),
+    );
+}
