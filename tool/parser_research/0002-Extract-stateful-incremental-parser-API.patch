+impl SyntaxTreeNode {
+    fn source_len(&self) -> usize {
+        match self {
+            Self::Leaf(chunk) => chunk.source_len,
+            Self::Branch { source_len, .. } => *source_len,
+        }
+    }
+
+    fn chunk_count(&self) -> usize {
+        match self {
+            Self::Leaf(_) => 1,
+            Self::Branch { chunk_count, .. } => *chunk_count,
+        }
+    }
+
+    fn height(&self) -> usize {
+        match self {
+            Self::Leaf(_) => 1,
+            Self::Branch { height, .. } => *height,
+        }
+    }
+}
+
+impl SyntaxTree {
+    fn from_chunks(chunks: Vec<Arc<SyntaxChunk>>) -> Self {
+        fn build(chunks: &[Arc<SyntaxChunk>]) -> Option<Arc<SyntaxTreeNode>> {
+            match chunks.len() {
+                0 => None,
+                1 => Some(Arc::new(SyntaxTreeNode::Leaf(chunks[0].clone()))),
+                len => {
+                    let middle = len / 2;
+                    Some(branch(
+                        build(&chunks[..middle]).unwrap(),
+                        build(&chunks[middle..]).unwrap(),
+                    ))
+                }
+            }
+        }
+        Self {
+            root: build(&chunks),
+        }
+    }
+
+    fn source_len(&self) -> usize {
+        self.root.as_deref().map_or(0, SyntaxTreeNode::source_len)
+    }
+
+    fn chunk_count(&self) -> usize {
+        self.root.as_deref().map_or(0, SyntaxTreeNode::chunk_count)
+    }
+
+    fn chunk_at(&self, index: usize) -> Arc<SyntaxChunk> {
+        assert!(index < self.chunk_count());
+        let mut node = self.root.as_ref().unwrap().clone();
+        let mut remaining = index;
+        loop {
+            match node.as_ref() {
+                SyntaxTreeNode::Leaf(chunk) => return chunk.clone(),
+                SyntaxTreeNode::Branch { left, right, .. } => {
+                    if remaining < left.chunk_count() {
+                        node = left.clone();
+                    } else {
+                        remaining -= left.chunk_count();
+                        node = right.clone();
+                    }
+                }
+            }
+        }
+    }
+
+    fn locate(&self, offset: usize) -> (usize, usize) {
+        assert!(offset <= self.source_len());
+        assert!(self.chunk_count() > 0);
+        let mut node = self.root.as_ref().unwrap().clone();
+        let mut remaining = offset;
+        let mut index = 0;
+        let mut start = 0;
+        loop {
+            match node.as_ref() {
+                SyntaxTreeNode::Leaf(chunk) => {
+                    return (index, start.min(self.source_len() - chunk.source_len));
+                }
+                SyntaxTreeNode::Branch { left, right, .. } => {
+                    if remaining < left.source_len()
+                        || (remaining == left.source_len() && right.source_len() == 0)
+                    {
+                        node = left.clone();
+                    } else {
+                        remaining -= left.source_len();
+                        start += left.source_len();
+                        index += left.chunk_count();
+                        node = right.clone();
+                    }
+                }
+            }
+        }
+    }
+
+    fn index_at_boundary(&self, offset: usize) -> Option<usize> {
+        if offset == 0 {
+            return Some(0);
+        }
+        if offset == self.source_len() {
+            return Some(self.chunk_count());
+        }
+        fn visit(node: &Arc<SyntaxTreeNode>, offset: usize) -> Option<usize> {
+            match node.as_ref() {
+                SyntaxTreeNode::Leaf(_) => None,
+                SyntaxTreeNode::Branch { left, right, .. } => {
+                    if offset == left.source_len() {
+                        Some(left.chunk_count())
+                    } else if offset < left.source_len() {
+                        visit(left, offset)
+                    } else {
+                        visit(right, offset - left.source_len())
+                            .map(|index| left.chunk_count() + index)
+                    }
+                }
+            }
+        }
+        visit(self.root.as_ref()?, offset)
+    }
+
+    fn replace(&self, start: usize, end: usize, inserted: SyntaxTree) -> SyntaxTree {
+        assert!(start <= end);
+        assert!(end <= self.chunk_count());
+        let (prefix, rest) = split_tree(self.root.clone(), start);
+        let (_, suffix) = split_tree(rest, end - start);
+        SyntaxTree {
+            root: concat_tree(concat_tree(prefix, inserted.root), suffix),
+        }
+    }
+
+    fn for_each_chunk(&self, mut visitor: impl FnMut(&Arc<SyntaxChunk>)) {
+        fn walk(node: &Option<Arc<SyntaxTreeNode>>, visitor: &mut impl FnMut(&Arc<SyntaxChunk>)) {
+            let Some(node) = node else { return };
+            match node.as_ref() {
+                SyntaxTreeNode::Leaf(chunk) => visitor(chunk),
+                SyntaxTreeNode::Branch { left, right, .. } => {
+                    walk(&Some(left.clone()), visitor);
+                    walk(&Some(right.clone()), visitor);
+                }
+            }
+        }
+        walk(&self.root, &mut visitor);
+    }
+
+    fn chunks_in_range(&self, start: usize, end: usize) -> Vec<Arc<SyntaxChunk>> {
+        assert!(start <= end && end <= self.chunk_count());
+        fn collect(
+            node: &Arc<SyntaxTreeNode>,
+            node_start: usize,
+            start: usize,
+            end: usize,
+            output: &mut Vec<Arc<SyntaxChunk>>,
+        ) {
+            let node_end = node_start + node.chunk_count();
+            if end <= node_start || start >= node_end {
+                return;
+            }
+            match node.as_ref() {
+                SyntaxTreeNode::Leaf(chunk) => output.push(chunk.clone()),
+                SyntaxTreeNode::Branch { left, right, .. } => {
+                    collect(left, node_start, start, end, output);
+                    collect(right, node_start + left.chunk_count(), start, end, output);
+                }
+            }
+        }
+        let mut output = Vec::with_capacity(end - start);
+        if let Some(root) = &self.root {
+            collect(root, 0, start, end, &mut output);
+        }
+        output
+    }
+}
+
+fn branch(left: Arc<SyntaxTreeNode>, right: Arc<SyntaxTreeNode>) -> Arc<SyntaxTreeNode> {
+    Arc::new(SyntaxTreeNode::Branch {
+        source_len: left.source_len() + right.source_len(),
+        chunk_count: left.chunk_count() + right.chunk_count(),
+        height: left.height().max(right.height()) + 1,
+        left,
+        right,
+    })
+}
+
+fn split_tree(
+    node: Option<Arc<SyntaxTreeNode>>,
+    index: usize,
+) -> (Option<Arc<SyntaxTreeNode>>, Option<Arc<SyntaxTreeNode>>) {
+    let Some(node) = node else {
+        assert_eq!(index, 0);
+        return (None, None);
+    };
+    assert!(index <= node.chunk_count());
+    if index == 0 {
+        return (None, Some(node));
+    }
+    if index == node.chunk_count() {
+        return (Some(node), None);
+    }
+    match node.as_ref() {
+        SyntaxTreeNode::Leaf(_) => unreachable!(),
+        SyntaxTreeNode::Branch { left, right, .. } => {
+            if index < left.chunk_count() {
+                let (prefix, rest) = split_tree(Some(left.clone()), index);
+                (prefix, concat_tree(rest, Some(right.clone())))
+            } else if index == left.chunk_count() {
+                (Some(left.clone()), Some(right.clone()))
+            } else {
+                let (rest, suffix) = split_tree(Some(right.clone()), index - left.chunk_count());
+                (concat_tree(Some(left.clone()), rest), suffix)
+            }
+        }
+    }
+}
+
+fn concat_tree(
+    left: Option<Arc<SyntaxTreeNode>>,
+    right: Option<Arc<SyntaxTreeNode>>,
+) -> Option<Arc<SyntaxTreeNode>> {
+    let (left, right) = match (left, right) {
+        (None, right) => return right,
+        (left, None) => return left,
+        (Some(left), Some(right)) => (left, right),
+    };
+    if left.height() > right.height() + 1 {
+        let SyntaxTreeNode::Branch {
+            left: outer_left,
+            right: inner_left,
+            ..
+        } = left.as_ref()
+        else {
+            unreachable!()
+        };
+        return Some(balance_tree(branch(
+            outer_left.clone(),
+            concat_tree(Some(inner_left.clone()), Some(right)).unwrap(),
+        )));
+    }
+    if right.height() > left.height() + 1 {
+        let SyntaxTreeNode::Branch {
+            left: inner_right,
+            right: outer_right,
+            ..
+        } = right.as_ref()
+        else {
+            unreachable!()
+        };
+        return Some(balance_tree(branch(
+            concat_tree(Some(left), Some(inner_right.clone())).unwrap(),
+            outer_right.clone(),
+        )));
+    }
+    Some(branch(left, right))
+}
+
+fn balance_tree(node: Arc<SyntaxTreeNode>) -> Arc<SyntaxTreeNode> {
+    let SyntaxTreeNode::Branch { left, right, .. } = node.as_ref() else {
+        return node;
+    };
+    let balance = left.height() as isize - right.height() as isize;
+    if balance > 1 {
+        let SyntaxTreeNode::Branch {
+            left: left_left,
+            right: left_right,
+            ..
+        } = left.as_ref()
+        else {
+            unreachable!()
+        };
+        if left_left.height() < left_right.height() {
+            let SyntaxTreeNode::Branch {
+                left: pivot_left,
+                right: pivot_right,
+                ..
+            } = left_right.as_ref()
+            else {
+                unreachable!()
+            };
+            return branch(
+                branch(left_left.clone(), pivot_left.clone()),
+                branch(pivot_right.clone(), right.clone()),
+            );
+        }
+        return branch(left_left.clone(), branch(left_right.clone(), right.clone()));
+    }
+    if balance < -1 {
+        let SyntaxTreeNode::Branch {
+            left: right_left,
+            right: right_right,
+            ..
+        } = right.as_ref()
+        else {
+            unreachable!()
+        };
+        if right_right.height() < right_left.height() {
+            let SyntaxTreeNode::Branch {
+                left: pivot_left,
+                right: pivot_right,
+                ..
+            } = right_left.as_ref()
+            else {
+                unreachable!()
+            };
+            return branch(
+                branch(left.clone(), pivot_left.clone()),
+                branch(pivot_right.clone(), right_right.clone()),
+            );
+        }
+        return branch(
+            branch(left.clone(), right_left.clone()),
+            right_right.clone(),
+        );
+    }
+    node
+}
+
+impl IncrementalBlockDocument {
+    fn new(text: String, options: &Options) -> Self {
+        let (chunks, next_id) = full_block_chunks(&text, options, 1);
+        let chunks = assign_initial_order_keys(chunks);
+        let chunks = SyntaxTree::from_chunks(chunks);
+        let references = ReferenceIndex::from_tree(&chunks);
+        Self {
+            text: ByteRope::from_str(&text),
+            chunks,
+            references,
+            next_id,
+        }
+    }
+
+    fn apply_edit(
+        &mut self,
+        old_range: Range<usize>,
+        replacement: &str,
+        options: &Options,
+    ) -> SpliceReceipt {
+        assert!(old_range.start <= old_range.end);
+        assert!(old_range.end <= self.text.len());
+        assert!(self.text.is_char_boundary(old_range.start));
+        assert!(self.text.is_char_boundary(old_range.end));
+
+        let old_chunk_count = self.chunks.chunk_count();
+        let (start_index, restart) = self.chunks.locate(old_range.start);
+
+        let edited = self
+            .text
+            .replace(old_range.start, old_range.end, replacement);
+        let new_end = old_range.start + replacement.len();
+        let byte_delta = edited.len() as isize - self.text.len() as isize;
+
+        let arena = Arena::new();
+        let mut parser = new_parser(&arena, options, edited.len());
+        let line_base = edited.newlines_before(restart);
+        parser.line_number = line_base;
+        parser.last_line_length = edited.previous_line_length(restart);
+        let mut new_boundaries = vec![restart];
+        let mut line_starts = vec![restart];
+        let mut offset = restart;
+        let mut convergence = None;
+        let parser_started = Instant::now();
+
+        while offset < edited.len() {
+            let (line_end, line) = edited.line_from(offset);
+            parser.process_line(&line);
+            offset = line_end;
+            if line.ends_with('\n') && line_starts.last().copied() != Some(offset) {
+                line_starts.push(offset);
+            }
+            if is_safe(&parser) {
+                if new_boundaries.last().copied() != Some(offset) {
+                    new_boundaries.push(offset);
+                }
+                if offset >= new_end {
+                    let mapped = offset as isize - byte_delta;
+                    if mapped >= old_range.end as isize
+                        && self.chunks.index_at_boundary(mapped as usize).is_some()
+                    {
+                        convergence = Some((offset, mapped as usize));
+                        break;
+                    }
+                }
+            }
+        }
+
+        let (new_convergence, old_convergence) = convergence.unwrap_or_else(|| {
+            if new_boundaries.last().copied() != Some(edited.len()) {
+                new_boundaries.push(edited.len());
+            }
+            (edited.len(), self.text.len())
+        });
+        if convergence.is_none() {
+            finish_blocks_only(&mut parser);
+        } else {
+            parser.propagate_list_sourcepos(parser.root);
+        }
+        let parser_us = parser_started.elapsed().as_micros();
+        let reference_occurrences = parser.reference_occurrences.clone().unwrap_or_default();
+
+        let splice_started = Instant::now();
+        let old_end_index = self
+            .chunks
+            .index_at_boundary(old_convergence)
+            .expect("convergence must be an old chunk boundary");
+        let (inserted, next_id) = chunks_from_parsed_root(
+            parser.root,
+            new_convergence,
+            line_base,
+            &line_starts,
+            &new_boundaries,
+            &reference_occurrences,
+            self.next_id,
+        );
+        let lower_order_key = if start_index == 0 {
+            0
+        } else {
+            self.chunks.chunk_at(start_index - 1).order_key
+        };
+        let upper_order_key = if old_end_index == old_chunk_count {
+            u128::MAX
+        } else {
+            self.chunks.chunk_at(old_end_index).order_key
+        };
+        let inserted = assign_order_keys_between(inserted, lower_order_key, upper_order_key);
+        assert_eq!(
+            inserted.iter().map(|chunk| chunk.source_len).sum::<usize>(),
+            new_convergence - restart,
+        );
+
+        let removed = self.chunks.chunks_in_range(start_index, old_end_index);
+        let reference_delta = self.references.apply(&removed, &inserted);
+        let chunks = self.chunks.replace(
+            start_index,
+            old_end_index,
+            SyntaxTree::from_chunks(inserted.clone()),
+        );
+        assert_eq!(chunks.source_len(), edited.len());
+        let splice_us = splice_started.elapsed().as_micros();
+        let delta_bytes = 40 + inserted.iter().map(chunk_wire_size).sum::<usize>();
+        let inserted_chunk_data = inserted
+            .iter()
+            .map(|chunk| IncrementalChunk {
+                id: chunk.id,
+                order_key: chunk.order_key,
+                source_len: chunk.source_len,
+                nodes: chunk.nodes.clone(),
+            })
+            .collect();
+
+        #[cfg(test)]
+        {
+            let edited_string = edited.materialize();
+            let (oracle_chunks, _) = full_block_chunks(&edited_string, options, 1);
+            let oracle_chunks = SyntaxTree::from_chunks(assign_initial_order_keys(oracle_chunks));
+            assert_eq!(
+                flatten_nodes(&chunks),
+                flatten_nodes(&oracle_chunks),
+                "incremental block tree diverged for edit {:?} -> {:?}",
+                old_range,
+                replacement,
+            );
+            assert_eq!(
+                self.references.winner_map(),
+                ReferenceIndex::from_tree(&oracle_chunks).winner_map(),
+                "incremental reference index diverged for edit {:?} -> {:?}",
+                old_range,
+                replacement,
+            );
+        }
+
+        let replaced_chunks = old_end_index - start_index;
+        let reused_chunks = start_index + old_chunk_count - old_end_index;
+        self.text = edited;
+        self.chunks = chunks;
+        self.next_id = next_id;
+
+        SpliceReceipt {
+            restart,
+            convergence: new_convergence,
+            reparsed_bytes: new_convergence - restart,
+            replaced_chunks,
+            inserted_chunks: inserted.len(),
+            reused_chunks,
+            parser_us,
+            splice_us,
+            delta_bytes,
+            reference_delta,
+            removed_chunk_range: start_index..old_end_index,
+            inserted_chunk_data,
+        }
+    }
+}
+
+fn full_block_chunks(text: &str, options: &Options, first_id: u64) -> (Vec<Arc<SyntaxChunk>>, u64) {
+    let arena = Arena::new();
+    let mut parser = new_parser(&arena, options, text.len());
+    let mut boundaries = vec![0];
+    let mut line_starts = vec![0];
+    let mut offset = 0;
+    while offset < text.len() {
+        let line_end = text[offset..]
+            .find('\n')
+            .map_or(text.len(), |relative| offset + relative + 1);
+        parser.process_line(&text[offset..line_end]);
+        offset = line_end;
+        if text.as_bytes().get(offset.saturating_sub(1)) == Some(&b'\n')
+            && line_starts.last().copied() != Some(offset)
+        {
+            line_starts.push(offset);
+        }
+        if is_safe(&parser) && boundaries.last().copied() != Some(offset) {
+            boundaries.push(offset);
+        }
+    }
+    finish_blocks_only(&mut parser);
+    if boundaries.last().copied() != Some(text.len()) {
+        boundaries.push(text.len());
+    }
+    let reference_occurrences = parser.reference_occurrences.clone().unwrap_or_default();
+    chunks_from_parsed_root(
+        parser.root,
+        text.len(),
+        0,
+        &line_starts,
+        &boundaries,
+        &reference_occurrences,
+        first_id,
+    )
+}
+
+fn chunks_from_parsed_root(
+    root: Node<'_>,
+    document_end: usize,
+    line_base: usize,
+    line_starts: &[usize],
+    boundaries: &[usize],
+    reference_occurrences: &[ReferenceOccurrenceProbe],
+    mut next_id: u64,
+) -> (Vec<Arc<SyntaxChunk>>, u64) {
+    if boundaries.len() == 1 {
+        assert!(root.first_child().is_none());
+        assert!(reference_occurrences.is_empty());
+        return (Vec::new(), next_id);
+    }
+    assert!(boundaries.len() >= 2);
+    let block_nodes: Vec<_> = root.children().collect();
+    let block_ranges: Vec<_> = block_nodes
+        .iter()
+        .map(|node| node_byte_range(*node, document_end, line_base, line_starts))
+        .collect();
+    let mut block_index = 0;
+    let definition_ranges: Vec<_> = reference_occurrences
+        .iter()
+        .map(|occurrence| {
+            sourcepos_byte_range(occurrence.sourcepos, document_end, line_base, line_starts)
+        })
+        .collect();
+    let mut definition_index = 0;
+    let mut chunks = Vec::with_capacity(boundaries.len() - 1);
+
+    for window in boundaries.windows(2) {
+        let chunk_start = window[0];
+        let chunk_end = window[1];
+        let mut nodes = Vec::new();
+        while block_index < block_nodes.len() && block_ranges[block_index].end <= chunk_end {
+            assert!(
+                block_ranges[block_index].start >= chunk_start,
+                "block {:?} crosses safe chunk {:?}",
+                block_ranges[block_index],
+                chunk_start..chunk_end,
+            );
+            nodes.push(owned_block_node(
+                block_nodes[block_index],
+                document_end,
+                line_base,
+                line_starts,
+                chunk_start,
+            ));
+            block_index += 1;
+        }
+        let mut definitions = Vec::new();
+        while definition_index < reference_occurrences.len()
+            && definition_ranges[definition_index].end <= chunk_end
+        {
+            assert!(definition_ranges[definition_index].start >= chunk_start);
+            let occurrence = &reference_occurrences[definition_index];
+            definitions.push(DefinitionOccurrence {
+                label: occurrence.label.clone(),
+                value: DefinitionValue {
+                    url: occurrence.reference.url.clone(),
+                    title: occurrence.reference.title.clone(),
+                },
+            });
+            definition_index += 1;
+        }
+        chunks.push(Arc::new(SyntaxChunk {
+            id: next_id,
+            order_key: 0,
+            source_len: chunk_end - chunk_start,
+            nodes,
+            definitions,
+        }));
+        next_id += 1;
+    }
+    assert_eq!(block_index, block_nodes.len());
+    assert_eq!(definition_index, reference_occurrences.len());
+    (chunks, next_id)
+}
+
+fn finish_blocks_only(parser: &mut Parser<'_, '_, '_>) {
+    while !parser.current.same_node(parser.root) {
+        parser.current = parser.finalize(parser.current).unwrap();
+    }
+    parser.finalize(parser.root);
+    parser.refmap.max_ref_size = parser.total_size.min(100000);
+    parser.propagate_list_sourcepos(parser.root);
+}
+
+fn node_byte_range(
+    node: Node<'_>,
+    document_end: usize,
+    line_base: usize,
+    line_starts: &[usize],
+) -> Range<usize> {
+    sourcepos_byte_range(node.data().sourcepos, document_end, line_base, line_starts)
+}
+
+fn sourcepos_byte_range(
+    sourcepos: Sourcepos,
+    document_end: usize,
+    line_base: usize,
+    line_starts: &[usize],
+) -> Range<usize> {
+    let start = line_starts
+        .get(sourcepos.start.line.saturating_sub(line_base + 1))
+        .copied()
+        .unwrap_or(document_end)
+        .saturating_add(sourcepos.start.column.saturating_sub(1))
+        .min(document_end);
+    let end = line_starts
+        .get(sourcepos.end.line.saturating_sub(line_base + 1))
+        .copied()
+        .unwrap_or(document_end)
+        .saturating_add(sourcepos.end.column)
+        .min(document_end)
+        .max(start);
+    start..end
+}
+
+fn owned_block_node(
+    node: Node<'_>,
+    document_end: usize,
+    line_base: usize,
+    line_starts: &[usize],
+    base: usize,
+) -> IncrementalNode {
+    let data = node.data();
+    let absolute = node_byte_range(node, document_end, line_base, line_starts);
+    let kind = format!("{:?}", data.value);
+    let content = data.content.clone();
+    drop(data);
+    IncrementalNode {
+        kind,
+        content,
+        range: absolute.start - base..absolute.end - base,
+        children: node
+            .children()
+            .map(|child| owned_block_node(child, document_end, line_base, line_starts, base))
+            .collect(),
+    }
+}
+
+fn flatten_nodes(chunks: &SyntaxTree) -> Vec<IncrementalNode> {
+    let mut output = Vec::new();
+    let mut base = 0;
+    chunks.for_each_chunk(|chunk| {
+        output.extend(chunk.nodes.iter().map(|node| shifted_node(node, base)));
+        base += chunk.source_len;
+    });
+    output
+}
+
+fn shifted_node(node: &IncrementalNode, delta: usize) -> IncrementalNode {
+    IncrementalNode {
+        kind: node.kind.clone(),
+        content: node.content.clone(),
+        range: node.range.start + delta..node.range.end + delta,
+        children: node
+            .children
+            .iter()
+            .map(|child| shifted_node(child, delta))
+            .collect(),
+    }
+}
+
+fn assign_initial_order_keys(chunks: Vec<Arc<SyntaxChunk>>) -> Vec<Arc<SyntaxChunk>> {
+    chunks
+        .into_iter()
+        .enumerate()
+        .map(|(index, chunk)| clone_chunk_with_order_key(&chunk, ((index as u128) + 1) << 64))
+        .collect()
+}
+
+fn assign_order_keys_between(
+    chunks: Vec<Arc<SyntaxChunk>>,
+    lower: u128,
+    upper: u128,
+) -> Vec<Arc<SyntaxChunk>> {
+    if chunks.is_empty() {
+        return chunks;
+    }
+    let step = (upper - lower) / ((chunks.len() as u128) + 1);
+    assert!(step > 0, "order-key gap exhausted");
+    chunks
+        .into_iter()
+        .enumerate()
+        .map(|(index, chunk)| {
+            clone_chunk_with_order_key(&chunk, lower + step * ((index as u128) + 1))
+        })
+        .collect()
+}
+
+fn clone_chunk_with_order_key(chunk: &Arc<SyntaxChunk>, order_key: u128) -> Arc<SyntaxChunk> {
+    Arc::new(SyntaxChunk {
+        id: chunk.id,
+        order_key,
+        source_len: chunk.source_len,
+        nodes: chunk.nodes.clone(),
+        definitions: chunk.definitions.clone(),
+    })
+}
+
+fn chunk_wire_size(chunk: &Arc<SyntaxChunk>) -> usize {
+    32 + varint_size(chunk.id as usize)
+        + varint_size(chunk.source_len)
+        + chunk.nodes.iter().map(node_wire_size).sum::<usize>()
+        + chunk
+            .definitions
+            .iter()
+            .map(|definition| {
+                varint_size(definition.label.len())
+                    + definition.label.len()
+                    + varint_size(definition.value.url.len())
+                    + definition.value.url.len()
+                    + varint_size(definition.value.title.len())
+                    + definition.value.title.len()
+            })
+            .sum::<usize>()
+}
+
+fn node_wire_size(node: &IncrementalNode) -> usize {
+    1 + varint_size(node.range.start)
+        + varint_size(node.range.end - node.range.start)
+        + varint_size(node.kind.len())
+        + node.kind.len()
+        + varint_size(node.content.len())
+        + node.content.len()
+        + node.children.iter().map(node_wire_size).sum::<usize>()
+}
+
+fn varint_size(mut value: usize) -> usize {
+    let mut bytes = 1;
+    while value >= 0x80 {
+        value >>= 7;
+        bytes += 1;
+    }
+    bytes
+}
+
+fn resumed_to_end<'a>(
+    arena: &'a Arena<'a>,
+    original: &str,
+    edited: &str,
+    restart: usize,
+    options: &Options,
+) -> Node<'a> {
+    let mut parser = new_parser(arena, options, edited.len());
+    feed(&mut parser, original, 0, restart, |_, _| {});
+    feed(&mut parser, edited, restart, edited.len(), |_, _| {});
+    finish(&mut parser)
+}
+
+fn work_until_convergence(
+    original: &str,
+    edited: &str,
+    restart: usize,
+    old_receipts: &[Receipt],
+    old_range: &Range<usize>,
+    new_end: usize,
+    options: &Options,
+) -> (Option<usize>, u128) {
+    let arena = Arena::new();
+    let mut parser = new_parser(&arena, options, edited.len());
+    feed(&mut parser, original, 0, restart, |_, _| {});
+    let old_by_offset: HashMap<_, _> = old_receipts
+        .iter()
+        .map(|receipt| (receipt.offset, receipt.state))
+        .collect();
+    let delta = edited.len() as isize - original.len() as isize;
+    let started = Instant::now();
+    let mut offset = restart;
+    while offset < edited.len() {
+        let line_end = edited[offset..]
+            .find('\n')
+            .map_or(edited.len(), |relative| offset + relative + 1);
+        parser.process_line(&edited[offset..line_end]);
+        offset = line_end;
+        if offset < new_end || !is_safe(&parser) {
+            continue;
+        }
+        let mapped = offset as isize - delta;
+        if mapped < old_range.end as isize {
+            continue;
+        }
+        let old_offset = mapped as usize;
+        let state_matches = old_by_offset.get(&old_offset) == Some(&state(&parser));
+        let suffix_matches = original.get(old_offset..) == edited.get(offset..);
+        if state_matches && suffix_matches {
+            return (Some(offset - new_end), started.elapsed().as_micros());
+        }
+    }
+    (None, started.elapsed().as_micros())
+}
+
+fn receipts(text: &str, options: &Options) -> Vec<Receipt> {
+    let arena = Arena::new();
+    let mut parser = new_parser(&arena, options, text.len());
+    let mut output = vec![Receipt {
+        offset: 0,
+        state: state(&parser),
+    }];
+    feed(&mut parser, text, 0, text.len(), |parser, offset| {
+        if is_safe(parser) {
+            output.push(Receipt {
+                offset,
+                state: state(parser),
+            });
+        }
+    });
+    output
+}
+
+fn new_parser<'a, 'o, 'c>(
+    arena: &'a Arena<'a>,
+    options: &'o Options<'c>,
+    total_size: usize,
+) -> Parser<'a, 'o, 'c>
+where
+    'c: 'o,
+{
+    let root = arena.alloc(
+        Ast {
+            value: NodeValue::Document,
+            content: String::new(),
+            sourcepos: (1, 1, 1, 1).into(),
+            #[cfg(feature = "attributes")]
+            attrs: None,
+            open: true,
+            last_line_blank: false,
+            table_visited: false,
+            line_offsets: Vec::new(),
+        }
+        .into(),
+    );
+    let mut parser = Parser::new(arena, root, options);
+    parser.total_size = total_size;
+    parser.reference_occurrences = Some(Vec::new());
+    parser
+}
+
+fn feed<'a, 'o, 'c>(
+    parser: &mut Parser<'a, 'o, 'c>,
+    text: &str,
+    start: usize,
+    end: usize,
+    mut after_line: impl FnMut(&Parser<'a, 'o, 'c>, usize),
+) {
+    let mut offset = start;
+    while offset < end {
+        let line_end = text[offset..end]
+            .find('\n')
+            .map_or(end, |relative| offset + relative + 1);
+        parser.process_line(&text[offset..line_end]);
+        offset = line_end;
+        after_line(parser, offset);
+    }
+}
+
+fn finish<'a>(parser: &mut Parser<'a, '_, '_>) -> Node<'a> {
+    parser.finalize_document();
+    parser.postprocess_text_nodes(parser.root);
+    parser.root
+}
+
+fn is_safe(parser: &Parser<'_, '_, '_>) -> bool {
+    parser.current.same_node(parser.root) && !parser.root.last_child_is_open()
+}
+
+fn state(parser: &Parser<'_, '_, '_>) -> u64 {
+    let mut labels: Vec<_> = parser.refmap.map.keys().collect();
+    labels.sort_unstable();
+    let mut hasher = DefaultHasher::new();
+    labels.hash(&mut hasher);
+    hasher.finish()
+}
+
+fn tree_signature(root: Node<'_>) -> String {
+    let mut output = String::new();
+    for edge in root.traverse() {
+        match edge {
+            NodeEdge::Start(node) => {
+                let data = node.data();
+                write!(
+                    output,
+                    "S{:?}@{:?}#{};",
+                    data.value, data.sourcepos, data.content
+                )
+                .unwrap();
+            }
+            NodeEdge::End(_) => output.push_str("E;"),
+        }
+    }
+    output
+}
+
+fn conservative_restart(receipts: &[Receipt], edit_start: usize) -> usize {
+    let containing = receipts.partition_point(|receipt| receipt.offset <= edit_start);
+    receipts[containing.saturating_sub(1)].offset
+}
+
+fn edit(original: &str, name: &'static str, needle: &str, replacement: &str) -> Edit {
+    let start = original
+        .find(needle)
+        .unwrap_or_else(|| panic!("missing edit needle: {needle:?}"));
+    edit_range(original, name, start..start + needle.len(), replacement)
+}
+
+fn edit_range(
+    original: &str,
+    name: &'static str,
+    old_range: Range<usize>,
+    replacement: &str,
+) -> Edit {
+    let mut markdown = String::with_capacity(original.len() + replacement.len());
+    markdown.push_str(&original[..old_range.start]);
+    markdown.push_str(replacement);
+    markdown.push_str(&original[old_range.end..]);
+    let new_end = old_range.start + replacement.len();
+    Edit {
+        name,
+        markdown,
+        old_range,
+        new_end,
+    }
+}
+
+fn percentile(values: &[usize], percentile: usize) -> usize {
+    values[(values.len().saturating_sub(1) * percentile) / 100]
+}
+
+fn flark_options<'c>() -> Options<'c> {
+    let mut options = Options::default();
+    options.extension.table = true;
+    options.extension.strikethrough = true;
+    options.extension.tasklist = true;
+    options.extension.autolink = true;
+    options.extension.tagfilter = true;
+    options
+}
+
+fn large_document(target_bytes: usize) -> String {
+    let mut output = String::from("<!-- bounded comment -->\n\n");
+    let mut index = 0;
+    while output.len() < target_bytes - 64 {
+        writeln!(output, "## Section {index}\n").unwrap();
+        writeln!(
+            output,
+            "Paragraph {index} has unique words {index}, **bold**, and [shared][shared].\n"
+        )
+        .unwrap();
+        writeln!(output, "- item {index}\n  - nested item {index}\n").unwrap();
+        writeln!(output, "```rust\ncode line {index}\n```\n").unwrap();
+        index += 1;
+    }
+    output.push_str("[shared]: https://example.com/old\n");
+    output
+}
