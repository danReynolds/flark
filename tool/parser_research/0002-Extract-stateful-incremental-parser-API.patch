+    let list = root
+        .children()
+        .find(|node| matches!(node.data().value, NodeValue::List(..)))
+        .expect("fixture must contain a top-level list");
+    let expected = match &list.data().value {
+        NodeValue::List(list) => list.tight,
+        _ => unreachable!(),
