+fn giant_list(target_bytes: usize) -> String {
+    let mut output = String::new();
+    let mut index = 0;
+    while output.len() < target_bytes {
+        writeln!(
+            output,
+            "- item {index} with **bold** text and [ref][shared]"
+        )
