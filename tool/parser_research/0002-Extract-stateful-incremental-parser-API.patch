+#[test]
+fn parser_leaf_cache_matches_clean_full_comrak_tree() {
+    let options = flark_options();
+    let markdown = large_document(1_000_000);
+    let snapshot = inline_document_snapshot(&markdown, &options);
+    let arena = Arena::new();
+    let full = parse_document(&arena, &markdown, &options);
+    let full_signature = tree_signature(full);
+    if snapshot.signature != full_signature {
+        let mismatch = snapshot
+            .signature
+            .bytes()
+            .zip(full_signature.bytes())
+            .position(|(left, right)| left != right)
+            .unwrap_or(snapshot.signature.len().min(full_signature.len()));
+        let start = mismatch.saturating_sub(120);
+        let incremental_end = (mismatch + 240).min(snapshot.signature.len());
+        let full_end = (mismatch + 240).min(full_signature.len());
+        panic!(
+            "leaf/full mismatch at {mismatch}:\nleaf={:?}\nfull={:?}",
+            &snapshot.signature[start..incremental_end],
+            &full_signature[start..full_end],
+        );
+    }
+    assert!(snapshot.leaves.len() > 10_000);
+}
