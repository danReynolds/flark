+        )
+        .unwrap();
+
+    assert_eq!(delta.base_revision, 0);
+    assert_eq!(delta.revision, 1);
+    assert_eq!(delta.before_hash32, before_hash32);
+    assert_eq!(delta.after_hash32, handle.content_hash32());
+    assert!(delta.splice.reparsed_bytes < 128);
+    assert!(delta.splice.delta_bytes < 256);
+    let materialized = handle.document.text.materialize();
+    assert_eq!(
+        handle.document.text.newlines(),
+        materialized.bytes().filter(|byte| *byte == b'\n').count(),
+    );
+    assert_eq!(
+        handle.content_hash32(),
+        ByteRope::from_str(&materialized).hash32(),
+    );
+
+    assert_eq!(
+        handle
+            .apply(
+                IncrementalEdit {
+                    base_revision: 0,
+                    before_hash32,
+                    start_utf8: start,
+                    end_utf8: start,
+                    replacement: "stale",
+                },
+                &options,
+            )
+            .unwrap_err(),
