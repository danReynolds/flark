+impl IncrementalDocument {
+    /// Parses `text` and creates revision zero of an incremental document.
+    pub fn new(text: String, options: &Options) -> Self {
+        Self {
+            revision: 0,
+            document: IncrementalBlockDocument::new(text, options),
+        }
+    }
+
+    /// Returns the document's current revision.
+    pub fn revision(&self) -> u64 {
+        self.revision
+    }
+
+    /// Returns the current UTF-8 byte length.
+    pub fn len_utf8(&self) -> usize {
+        self.document.text.len()
+    }
+
+    /// Returns whether the source is empty.
+    pub fn is_empty(&self) -> bool {
+        self.len_utf8() == 0
+    }
+
+    /// Returns the current source fingerprint used for edit validation.
+    pub fn content_hash32(&self) -> u32 {
+        self.document.text.hash32()
+    }
+
+    /// Applies one validated edit and returns bounded-work metadata.
+    pub fn apply(
+        &mut self,
+        request: IncrementalEdit<'_>,
+        options: &Options,
+    ) -> Result<IncrementalDelta, IncrementalError> {
+        if request.base_revision != self.revision {
+            return Err(IncrementalError::Revision {
+                expected: self.revision,
+                actual: request.base_revision,
+            });
+        }
+        let before_hash32 = self.content_hash32();
+        if request.before_hash32 != before_hash32 {
+            return Err(IncrementalError::Hash {
+                expected: before_hash32,
+                actual: request.before_hash32,
+            });
+        }
+        if request.start_utf8 > request.end_utf8 || request.end_utf8 > self.document.text.len() {
+            return Err(IncrementalError::Range);
+        }
+        if !self.document.text.is_char_boundary(request.start_utf8)
+            || !self.document.text.is_char_boundary(request.end_utf8)
+        {
+            return Err(IncrementalError::Utf8Boundary);
+        }
+        let splice = self.document.apply_edit(
+            request.start_utf8..request.end_utf8,
+            request.replacement,
+            options,
+        );
+        let base_revision = self.revision;
+        self.revision += 1;
+        Ok(IncrementalDelta {
+            base_revision,
+            revision: self.revision,
+            before_hash32,
+            after_hash32: self.content_hash32(),
+            splice,
+        })
+    }
+}
+
