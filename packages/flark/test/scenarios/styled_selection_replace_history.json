{
  "schemaVersion": 1,
  "id": "styled-selection-replace-history",
  "description": "Replacement inside a projected strong run round-trips exact source and ranged selection through undo and redo.",
  "initialSource": "Before **bold** after.\n",
  "activation": {
    "needle": "bold",
    "occurrence": 0,
    "utf16OffsetInNeedle": 1
  },
  "steps": [
    {
      "type": "selectSourceRange",
      "baseUtf16": 10,
      "extentUtf16": 12
    },
    {
      "type": "pasteText",
      "text": "X"
    },
    {
      "type": "waitForIdle"
    },
    {
      "type": "checkpoint",
      "id": "replaced",
      "source": "Before **bXd** after.\n",
      "caretUtf16": 11
    },
    {
      "type": "undo"
    },
    {
      "type": "waitForIdle"
    },
    {
      "type": "checkpoint",
      "id": "undone",
      "source": "Before **bold** after.\n",
      "selectionBaseUtf16": 10,
      "selectionExtentUtf16": 12
    },
    {
      "type": "redo"
    },
    {
      "type": "waitForIdle"
    }
  ],
  "schedules": [
    {
      "id": "default"
    }
  ],
  "expect": {
    "source": "Before **bXd** after.\n",
    "caretUtf16": 11,
    "resyncCount": 0,
    "faulted": false,
    "forbiddenSurfaceSubstrings": ["**", "<empty>"],
    "paintedSurfaceNeverContains": ["**", "<empty>"]
  }
}
