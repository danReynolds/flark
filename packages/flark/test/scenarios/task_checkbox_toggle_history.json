{
  "schemaVersion": 1,
  "id": "task-checkbox-toggle-history",
  "description": "A rendered task checkbox toggles through the semantic action lane without moving a remote caret, and participates in undo and redo.",
  "initialSource": "- [ ] todo\n\nSelection stays here.\n",
  "activation": {
    "needle": "Selection stays here.",
    "occurrence": 0,
    "utf16OffsetInNeedle": 21
  },
  "steps": [
    {
      "type": "toggleTaskAtUtf16",
      "targetUtf16": 6
    },
    {
      "type": "waitForIdle"
    },
    {
      "type": "checkpoint",
      "id": "checked-selection-preserved",
      "source": "- [x] todo\n\nSelection stays here.\n",
      "caretUtf16": 33
    },
    {
      "type": "undo"
    },
    {
      "type": "checkpoint",
      "id": "undo-unchecked",
      "source": "- [ ] todo\n\nSelection stays here.\n",
      "caretUtf16": 33
    },
    {
      "type": "redo"
    },
    {
      "type": "waitForIdle"
    }
  ],
  "schedules": [
    {
      "id": "immediate"
    }
  ],
  "expect": {
    "source": "- [x] todo\n\nSelection stays here.\n",
    "caretUtf16": 33,
    "resyncCount": 0,
    "faulted": false,
    "forbiddenSurfaceSubstrings": ["[ ]", "[x]", "<empty>"],
    "paintedSurfaceNeverContains": ["[ ]", "[x]", "<empty>"]
  }
}
