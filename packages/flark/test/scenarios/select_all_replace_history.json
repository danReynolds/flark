{
  "schemaVersion": 1,
  "id": "select-all-replace-history",
  "description": "Select All includes the complete source, including its unpainted trailing newline, and replacement round-trips through history.",
  "initialSource": "First **bold**.\n\nSecond line.\n",
  "activation": {
    "needle": "bold",
    "occurrence": 0,
    "utf16OffsetInNeedle": 1
  },
  "steps": [
    {
      "type": "selectAll"
    },
    {
      "type": "checkpoint",
      "id": "selected",
      "source": "First **bold**.\n\nSecond line.\n",
      "selectionBaseUtf16": 0,
      "selectionExtentUtf16": 30
    },
    {
      "type": "pasteText",
      "text": "Replacement.\n"
    },
    {
      "type": "waitForIdle"
    },
    {
      "type": "checkpoint",
      "id": "replaced",
      "source": "Replacement.\n",
      "caretUtf16": 13
    },
    {
      "type": "undo"
    },
    {
      "type": "waitForIdle"
    },
    {
      "type": "checkpoint",
      "id": "undone",
      "source": "First **bold**.\n\nSecond line.\n",
      "selectionBaseUtf16": 0,
      "selectionExtentUtf16": 30
    },
    {
      "type": "redo"
    },
    {
      "type": "waitForIdle"
    }
  ],
  "schedules": [
    {
      "id": "shortcut"
    }
  ],
  "expect": {
    "source": "Replacement.\n",
    "caretUtf16": 13,
    "resyncCount": 0,
    "faulted": false,
    "forbiddenSurfaceSubstrings": ["<empty>"],
    "paintedSurfaceNeverContains": ["<empty>"]
  }
}
