{
  "schemaVersion": 1,
  "id": "select-all-type-history",
  "description": "Typing after Select All replaces the complete source and undo restores the document-wide selection.",
  "initialSource": "First **bold**.\n\nSecond line.\n",
  "activation": {
    "needle": "bold",
    "occurrence": 0,
    "utf16OffsetInNeedle": 1
  },
  "steps": [
    {
      "type": "selectAll"
    },
    {
      "type": "checkpoint",
      "id": "selected",
      "source": "First **bold**.\n\nSecond line.\n",
      "selectionBaseUtf16": 0,
      "selectionExtentUtf16": 30
    },
    {
      "type": "typeText",
      "text": "X",
      "intervalMs": 0
    },
    {
      "type": "waitForIdle"
    },
    {
      "type": "checkpoint",
      "id": "replaced",
      "source": "X",
      "caretUtf16": 1
    },
    {
      "type": "undo"
    },
    {
      "type": "waitForIdle"
    },
    {
      "type": "checkpoint",
      "id": "undone",
      "source": "First **bold**.\n\nSecond line.\n",
      "selectionBaseUtf16": 0,
      "selectionExtentUtf16": 30
    },
    {
      "type": "redo"
    },
    {
      "type": "waitForIdle"
    }
  ],
  "schedules": [
    {
      "id": "native-text"
    }
  ],
  "expect": {
    "source": "X",
    "caretUtf16": 1,
    "resyncCount": 0,
    "faulted": false,
    "forbiddenSurfaceSubstrings": ["<empty>"],
    "paintedSurfaceNeverContains": ["<empty>"]
  }
}
