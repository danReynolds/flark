{
  "schemaVersion": 1,
  "id": "table-cell-rapid-typing-history",
  "description": "Rapid typing inside a rendered table cell stays marker-free and round-trips through native history.",
  "initialSource": "| name | count |\n| --- | ---: |\n| apple | 2 |\n",
  "activation": {
    "needle": "apple",
    "occurrence": 0,
    "utf16OffsetInNeedle": 5
  },
  "steps": [
    {
      "type": "typeText",
      "text": "s",
      "intervalMs": 0
    },
    {
      "type": "waitForIdle"
    },
    {
      "type": "checkpoint",
      "id": "pluralized",
      "source": "| name | count |\n| --- | ---: |\n| apples | 2 |\n",
      "caretUtf16": 40
    },
    {
      "type": "undo"
    },
    {
      "type": "waitForIdle"
    },
    {
      "type": "checkpoint",
      "id": "undone",
      "source": "| name | count |\n| --- | ---: |\n| apple | 2 |\n",
      "caretUtf16": 39
    },
    {
      "type": "redo"
    },
    {
      "type": "waitForIdle"
    }
  ],
  "schedules": [
    {
      "id": "immediate"
    }
  ],
  "expect": {
    "source": "| name | count |\n| --- | ---: |\n| apples | 2 |\n",
    "caretUtf16": 40,
    "resyncCount": 0,
    "faulted": false,
    "forbiddenSurfaceSubstrings": ["| ---", "---:", "<empty>"],
    "paintedSurfaceNeverContains": ["| ---", "---:", "<empty>"]
  }
}
