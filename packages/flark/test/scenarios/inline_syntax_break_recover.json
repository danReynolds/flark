{
  "schemaVersion": 1,
  "id": "inline-syntax-break-recover",
  "description": "Incomplete emphasis remains an exact local source island, completing it restores projection, and breaking it again preserves exact source and selection.",
  "initialSource": "Before bold after\n",
  "activation": {
    "needle": "bold",
    "occurrence": 0,
    "utf16OffsetInNeedle": 0
  },
  "steps": [
    {
      "type": "typeText",
      "text": "*",
      "intervalMs": 0
    },
    {
      "type": "waitForIdle"
    },
    {
      "type": "checkpoint",
      "id": "incomplete",
      "source": "Before *bold after\n",
      "caretUtf16": 8,
      "settledPresentation": "Before *bold after"
    },
    {
      "type": "selectSourceRange",
      "baseUtf16": 12,
      "extentUtf16": 12
    },
    {
      "type": "typeText",
      "text": "*",
      "intervalMs": 0
    },
    {
      "type": "waitForIdle"
    },
    {
      "type": "checkpoint",
      "id": "completed",
      "source": "Before *bold* after\n",
      "caretUtf16": 13,
      "settledPresentation": "Before bold after"
    },
    {
      "type": "selectSourceRange",
      "baseUtf16": 12,
      "extentUtf16": 12
    },
    {
      "type": "typeText",
      "text": " ",
      "intervalMs": 0
    },
    {
      "type": "waitForIdle"
    },
    {
      "type": "checkpoint",
      "id": "broken",
      "source": "Before *bold * after\n",
      "caretUtf16": 13,
      "settledPresentation": "Before *bold * after"
    },
    {
      "type": "pressBackspace"
    },
    {
      "type": "waitForIdle"
    },
    {
      "type": "checkpoint",
      "id": "recovered",
      "source": "Before *bold* after\n",
      "caretUtf16": 12,
      "settledPresentation": "Before bold after"
    },
    {
      "type": "typeText",
      "text": " ",
      "intervalMs": 0
    },
    {
      "type": "waitForIdle"
    }
  ],
  "schedules": [
    {
      "id": "immediate"
    }
  ],
  "expect": {
    "source": "Before *bold * after\n",
    "caretUtf16": 13,
    "resyncCount": 0,
    "faulted": false,
    "forbiddenSurfaceSubstrings": ["<empty>"],
    "paintedSurfaceNeverContains": ["<empty>"],
    "expectedPaintedPresentations": [
      "Before *bold after",
      "Before bold after",
      "Before *bold * after",
      "Before bold after",
      "Before *bold * after"
    ],
    "expectedPaintedRenderPlanSamples": 5,
    "expectedPaintedVisualStateSamples": 5
  }
}
