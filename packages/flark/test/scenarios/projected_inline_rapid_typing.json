{
  "schemaVersion": 1,
  "id": "projected-inline-rapid-typing",
  "description": "Rapid literal input inside certified strong text preserves exact source, caret, and marker-free paint.",
  "initialSource": "Before **bold** after\n",
  "activation": {
    "needle": "bold",
    "occurrence": 0,
    "utf16OffsetInNeedle": 2
  },
  "steps": [
    {
      "type": "typeText",
      "text": "rapid",
      "intervalMs": 0
    },
    {
      "type": "waitForIdle"
    }
  ],
  "schedules": [
    {
      "id": "immediate"
    }
  ],
  "expect": {
    "source": "Before **borapidld** after\n",
    "caretUtf16": 16,
    "resyncCount": 0,
    "faulted": false,
    "forbiddenSurfaceSubstrings": ["**", "<empty>"],
    "paintedSurfaceNeverContains": ["**", "<empty>"]
  }
}
